@{
    ViewData["Title"] = "庫存管理 - 調撥";
    var books = ViewBag.Books as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var rows = ViewBag.Rows as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    int bookId = ViewBag.BookID is int ? (int)ViewBag.BookID : 0;
    string bookTitle = ViewBag.BookTitle as string ?? "";
}

<div class="inventory-page">
<h3>@ViewData["Title"] @if(!string.IsNullOrEmpty(bookTitle)){ <small>- @bookTitle</small> }</h3>

@if (TempData["ok"] != null)
{
    <div class="alert alert-success">@TempData["ok"]</div>
}
@if (TempData["err"] != null)
{
    <div class="alert alert-warning">@TempData["err"]</div>
}


<div class="mb-3 d-flex gap-2 align-items-center">
    <form method="get" class="d-flex gap-2 align-items-center">
        <label class="form-label mb-0 me-2">選擇書籍：</label>
        <select name="bookId" class="form-select" style="min-width:360px;">
            @foreach (var b in books)
            {
                if (b.BookID == bookId)
                {
                    <option value="@b.BookID" selected>@b.Title</option>
                }
                else
                {
                    <option value="@b.BookID">@b.Title</option>
                }
            }
        </select>
        <button type="submit" class="btn btn-primary btn-sm">載入</button>
    </form>

    <a asp-area="Books" asp-controller="Books" asp-action="Index" class="btn btn-light btn-sm ms-3">回書籍清單</a>
</div>

@if (!rows.Any())
{
    <div class="alert alert-info">目前沒有可顯示的據點（請確認是否有啟用的據點）。</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>據點名稱</th>
                    <th style="width:140px;">現有庫存</th>
                    <th style="width:140px;">已保留</th>
                    <th style="width:160px;">操作</th>
                </tr>
            </thead>
            <tbody id="inv-rows-tbody">
                @foreach (var r in rows)
                {
                    var name = (string)r.BranchName;
                    var onhand = (r.OnHand == null) ? 0 : (int)r.OnHand;
                    var reserved = (r.Reserved == null) ? 0 : (int)r.Reserved;
                    <tr>
                        <td>@name</td>
                        <td><span class="badge bg-info">@onhand</span></td>
                        <td><span class="text-muted">@reserved</span></td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-primary btn-open-transfer-modal"
                                    data-branchid="@r.BranchID"
                                    data-branchname="@name"
                                    data-onhand="@onhand"
                                    data-reserved="@reserved"
                                    data-bs-toggle="modal"
                                    data-bs-target="#transferModal">
                                調撥
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Transfer Modal -->
<div class="modal fade" id="transferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Books" asp-controller="Inventory" asp-action="Transfer" method="post" id="transferForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookId" value="@bookId" />
                <input type="hidden" name="fromBranchId" id="modal-fromBranchId" value="" />

                <div class="modal-header">
                    <h5 class="modal-title">庫存調撥</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">來源據點</label>
                        <input type="text" id="modal-fromBranchName" class="form-control" readonly />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">來源現有庫存 (OnHand)</label>
                        <input type="text" id="modal-fromOnHand" class="form-control" readonly />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">來源已保留 (Reserved)</label>
                        <input type="text" id="modal-fromReserved" class="form-control" readonly />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">目的據點</label>
                        <select name="toBranchId" id="modal-toBranchId" class="form-select" required>
                            <option value="">-- 請選擇目的據點 --</option>
                            @foreach (var t in rows)
                            {
                                <option value="@t.BranchID">@t.BranchName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">數量</label>
                        <input type="number" name="quantity" id="modal-quantity" class="form-control" min="1" value="1" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">原因 / 備註（選填）</label>
                        <input type="text" name="reason" id="modal-reason" class="form-control" maxlength="200" />
                    </div>

                    <div id="modal-alert" class="alert alert-danger d-none" role="alert"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">確認調撥</button>
                </div>
            </form>
        </div>
    </div>
</div>
</div>
@section Scripts {
    <script>
        (function(){
            // ---------- helper: 以 AJAX 取得 rows JSON（server 需有 /Inventory/GetRows?bookId=...） ----------
            async function loadRows(bookId) {
                const tbody = document.getElementById('inv-rows-tbody');
                if (!tbody) return;
                try {
                    const url = '@Url.Action("GetRows", "Inventory", new { area = "Books" })' + '?bookId=' + encodeURIComponent(bookId);
                    const resp = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' }});
                    if (!resp.ok) throw new Error('載入失敗: ' + resp.status);
                    const rows = await resp.json();

                    // 清空並重建 tbody
                    tbody.innerHTML = '';
                    for (const r of rows) {
                        const tr = document.createElement('tr');

                        const tdName = document.createElement('td');
                        tdName.textContent = r.branchName;
                        tr.appendChild(tdName);

                        const tdOnHand = document.createElement('td');
                        tdOnHand.innerHTML = `<span class="badge bg-info">${r.onHand ?? 0}</span>`;
                        tr.appendChild(tdOnHand);

                        const tdReserved = document.createElement('td');
                        tdReserved.innerHTML = `<span class="text-muted">${r.reserved ?? 0}</span>`;
                        tr.appendChild(tdReserved);

                        const tdOp = document.createElement('td');
                        tdOp.innerHTML = `<button type="button" class="btn btn-sm btn-primary btn-open-transfer-modal"
                                            data-branchid="${r.branchID}"
                                            data-branchname="${escapeHtml(r.branchName)}"
                                            data-onhand="${r.onHand ?? 0}"
                                            data-reserved="${r.reserved ?? 0}"
                                            data-bs-toggle="modal" data-bs-target="#transferModal">調撥</button>`;
                        tr.appendChild(tdOp);

                        tbody.appendChild(tr);
                    }

                    // 重新綁定 modal 按鈕的 click handler
                    bindOpenTransferButtons();
                } catch (ex) {
                    console.error(ex);
                }
            }

            // escapeHtml 保護（簡單）
            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            // ---------- 綁定按鈕與 modal 填值邏輯 ----------
            function bindOpenTransferButtons() {
                document.querySelectorAll('.btn-open-transfer-modal').forEach(btn => {
                    btn.removeEventListener('click', openTransferHandler);
                    btn.addEventListener('click', openTransferHandler);
                });
            }

            function openTransferHandler() {
                const branchId = this.getAttribute('data-branchid');
                const branchName = this.getAttribute('data-branchname');
                const onhand = parseInt(this.getAttribute('data-onhand') || '0', 10);
                const reserved = parseInt(this.getAttribute('data-reserved') || '0', 10);
                const available = Math.max(0, onhand - reserved);

                document.getElementById('modal-fromBranchId').value = branchId;
                document.getElementById('modal-fromBranchName').value = branchName;
                document.getElementById('modal-fromOnHand').value = onhand;
                document.getElementById('modal-fromReserved').value = reserved;

                // 避免目的選到自己
                const toSel = document.getElementById('modal-toBranchId');
                if (toSel) {
                    for (let i = 0; i < toSel.options.length; i++) {
                        toSel.options[i].disabled = (toSel.options[i].value === branchId);
                    }
                    if (toSel.value === branchId) toSel.value = "";
                }

                // 預設數量：至少 1，最大為 available（顯示上讓使用者知道）
                const qtyEl = document.getElementById('modal-quantity');
                if (qtyEl) qtyEl.value = Math.max(1, Math.min(available || 1, 1));

                const alertBox = document.getElementById('modal-alert');
                if (alertBox) { alertBox.classList.add('d-none'); alertBox.textContent = ''; }
            }

            // ---------- 前端驗證（留用） ----------
            const form = document.getElementById('transferForm');
            if (form) {
                form.addEventListener('submit', function(e){
                    const onhand = parseInt(document.getElementById('modal-fromOnHand').value || '0', 10);
                    const reserved = parseInt(document.getElementById('modal-fromReserved').value || '0', 10);
                    const available = Math.max(0, onhand - reserved);
                    const qty = parseInt(document.getElementById('modal-quantity').value || '0', 10);
                    const toBranchId = document.getElementById('modal-toBranchId').value;
                    const alertBox = document.getElementById('modal-alert');

                    if (!toBranchId) {
                        e.preventDefault();
                        alertBox.textContent = '請選擇目的據點';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                    if (isNaN(qty) || qty <= 0) {
                        e.preventDefault();
                        alertBox.textContent = '請輸入正整數的調撥數量';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                    if (qty > available) {
                        e.preventDefault();
                        alertBox.textContent = '調撥數量不可超過來源據點可用數量（' + available + '）';
                        alertBox.classList.remove('d-none');
                        return;
                    }

                    // 若你要用 AJAX 送出（不 reload），請啟用下面被註解的段落並註解掉 return（或 e.preventDefault()）
                    // 為了安全，若用 AJAX 必須把 antiforgery token 加入 header（下段示範）。
                });
            }

            // ---------- 下拉書籍即時更新（不整頁 reload） ----------
            const bookSelect = document.querySelector('select[name="bookId"]');
            if (bookSelect) {
                bookSelect.addEventListener('change', function(){
                    // 方案 A：用 AJAX 立即重載 rows（需要 Controller GetRows 回傳 JSON）
                    const bookId = this.value;
                    if (bookId) loadRows(bookId);

                    // 並且把 URL 的 query string 更新（不 reload），讓刷新/分享能保留 bookId
                    const u = new URL(window.location.href);
                    u.searchParams.set('bookId', bookId);
                    window.history.replaceState({}, '', u.toString());
                });
            }

            // 初次綁定（如果 server render 已有按鈕，綁定它們）
            bindOpenTransferButtons();
        })();
    </script>
}

@section Styles {
    <style>
        /* Inventory page custom */
        .inventory-page .form-select {
            min-width: 360px;
            max-width: 60vw;
        }

        /* 表格樣式 */
        #inv-rows-tbody tr td {
            vertical-align: middle;
        }

        #inv-rows-tbody td:first-child {
            font-weight: 600;
        }

        /* badge 調整（數字圓點） */
        #inv-rows-tbody .badge.bg-info {
            background: linear-gradient(135deg,#1ccad6,#00bcd4);
            color: #fff;
            border-radius: 999px;
            padding: 0.35rem 0.6rem;
            font-weight: 600;
            min-width: 34px;
            text-align: center;
            display: inline-block;
        }

        /* 操作按鈕小調整 */
        .btn-open-transfer-modal {
            min-width: 68px;
            padding: 0.28rem 0.6rem;
            border-radius: 6px;
        }

        /* Modal 內提示字顏色 */
        #modal-alert {
            margin-top: 0.4rem;
        }

        /* 小螢幕友善：選書列換行 */
        @@media (max-width: 768px) {
            .inventory-page .mb-3.d-flex

        {
            flex-direction: column;
            align-items: stretch;
            gap: .5rem;
        }

        .inventory-page .form-select {
            width: 100%;
            min-width: auto;
        }

        #inv-rows-tbody td {
            padding: .6rem .5rem;
        }

        }

        /* 可選：成功/錯誤訊息區塊加距離 */
        .inventory-page .alert {
            margin-top: .6rem;
        }
    </style>
}
