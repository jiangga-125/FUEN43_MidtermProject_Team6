@model List<BookLoop.Models.Dto.ImportBookDto>

@{
    ViewData["Title"] = "匯入書籍 - 預覽";
}

<h1>匯入書籍（預覽）</h1>
<p>請勾選欲匯入的書籍（預設全選）。若檔案很大請考慮分頁上傳。</p>

<form asp-area="Books" asp-controller="Import" asp-action="CommitBooks" method="post">
    @Html.AntiForgeryToken()

    <table class="table table-bordered table-sm">
        <thead class="table-light">
            <tr>
                <th style="width:60px">匯入</th>
                <th>ISBN</th>
                <th>書名</th>
                <th>作者</th>
                <th>出版社</th>
                <th>出版日期</th>
                <th>分類</th>
                <th>封面</th>
            </tr>
        </thead>
        <tbody>
            @{
                var list = Model ?? new List<BookLoop.Models.Dto.ImportBookDto>();
            }
            @for (int i = 0; i < list.Count; i++)
            {
                <tr>
                    <td class="align-middle text-center">
                        <input type="hidden" name="books[@i].Selected" value="false" />
                        <input type="checkbox" name="books[@i].Selected" value="true" @(list[i].Selected ? "checked" : "") />
                    </td>

                    <td>
                        <input type="hidden" name="books[@i].ISBN" value="@list[i].ISBN" />
                        @Html.DisplayFor(_ => list[i].ISBN)
                    </td>

                    <td>
                        <input type="hidden" name="books[@i].Title" value="@list[i].Title" />
                        @Html.DisplayFor(_ => list[i].Title)
                    </td>

                    <td>
                        <input type="hidden" name="books[@i].Author" value="@list[i].Author" />
                        @Html.DisplayFor(_ => list[i].Author)
                    </td>

                    <td>
                        <input type="hidden" name="books[@i].Publisher" value="@list[i].Publisher" />
                        @Html.DisplayFor(_ => list[i].Publisher)
                    </td>

                    <td>
                        <input type="hidden" name="books[@i].PublishDate" value="@list[i].PublishDate" />
                        @Html.DisplayFor(_ => list[i].PublishDate)
                    </td>

                    <td>
                        <input type="hidden" name="books[@i].Category" value="@list[i].Category" />
                        @Html.DisplayFor(_ => list[i].Category)
                    </td>

                    <td>
                        <input type="hidden" name="books[@i].ImagePath" value="@list[i].ImagePath" />
                        @if (!string.IsNullOrWhiteSpace(list[i].ImagePath))
                        {
                            <img src="@list[i].ImagePath" alt="封面" style="max-height:80px;" onerror="this.style.display='none';" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">確認匯入選取項目</button>
        <a asp-area="Books" asp-controller="Import" asp-action="Index" class="btn btn-secondary">取消</a>
    </div>
</form>
