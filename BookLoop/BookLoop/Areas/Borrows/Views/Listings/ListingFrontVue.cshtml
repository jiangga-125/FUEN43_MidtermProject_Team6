
@section Styles {
    <style>
        /* 新增：封面縮小 + 固定高度（透過調整 --cover-h） */
        .card-compact .cover {
            width: 100%;
            height: var(--cover-h, 250px); /* ★ 預設 180px，可依喜好改 150~200 */
            object-fit: cover;
            display: block;
            border-top-left-radius: .375rem;
            border-top-right-radius: .375rem;
        }

        /* 兩行省略號:標題文字太長時，只顯示最多 2 行 */
        .text-truncate-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }


    </style>
}


<div id="app">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <div class="ms-auto d-flex align-items-center gap-2">
            <span class="text-muted small">每頁</span>
            <!-- 用 perPageOptions 產生選項；rowsPerPage 綁定目前每頁筆數 -->
            <select v-model.number="rowsPerPage" class="form-select form-select-sm" style="width: auto;">
                <option v-for="opt in perPageOptions" :key="opt" :value="opt">{{ opt }}</option>
            </select>
            <span class="text-muted small">筆（共 {{ totalCount }} 筆）</span>
        </div>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        <div class="col" v-for="item in pagedItems" :key="item.listingId">
            <div class="card h-100 shadow-sm card-compact">
                
                    <img :src="(item.imageUrl || '').trim() || '/images/borrow/noimage.jpeg'"
                         :alt="item.title"
                         :title="item.title"
                     class="card-img-top cover"
                     loading="lazy"
                     v-on:error="e => { e.target.onerror = null; e.target.src = '/images/borrow/noimage.jpeg' }" />
                

                <div class="card-body d-flex flex-column">
                    <h6 class="card-title mb-1 text-truncate-2 fw-semibold">書名 : {{ item.title }}</h6>
                    <p class="card-subtitle text-muted mb-2" v-if="item.authorName">
                        作者：{{ item.authorName }}
                    </p>

                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2 fs-4">
                        <span class="badge" :class="statusBadgeClass(item.status)">
                            {{ statusText(item.status) }}
                        </span>                        
                    </div>

                    <dl class="mb-3 small text-muted">
                       
                        <div class="d-flex">
                            <dt class="me-2">分類：</dt><dd class="mb-0">{{ item.categoryName || '—' }}</dd>
                        </div>
                        <div class="d-flex">
                            <dt class="me-2">出版社：</dt><dd class="mb-0">{{ item.publisherName || '—' }}</dd>
                        </div>
                        <div class="d-flex">
                            <dt class="me-2">書況：</dt><dd class="mb-0">{{ item.condition || '—' }}</dd>
                        </div>
                        <div class="d-flex">
                            <dt class="me-2">ISBN：</dt><dd class="mb-0">{{ item.isbn || '—' }}</dd>
                        </div>
                    </dl>

                    <div class="mt-auto d-flex gap-2">
                        @* <a v-if="item.status === 0" class="btn btn-primary btn-sm w-25"
                           :href="`/Borrows/Reservations/BeforeReservation/${item.listingId}`">借書</a> *@
                        <button v-if="item.status === 0"
                                type="button"
                                class="btn btn-primary btn-sm w-25"
								v-on:click="openBeforeReservation(item.listingId)">
                                
                            借書
                        </button>

                        <a v-if="item.status === 2" class="btn btn-danger btn-sm w-25"
                           :href="`/Borrows/Reservations/CreateReservation/${item.listingId}`">預約</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div v-if="!totalCount" class="text-muted py-4 text-center">目前沒有資料</div>
    <!-- 分頁器-->
    <nav v-if="totalPages > 1" class="mt-3" aria-label="Page navigation">
        <ul class="pagination pagination-lg justify-content-center flex-wrap">
            <li class="page-item" :class="{ disabled: currentPage === 1 }">
                <button class="page-link" v-on:click="goTo(1)" aria-label="First">«</button>
            </li>
            <li class="page-item" :class="{ disabled: currentPage === 1 }">
                <button class="page-link" v-on:click="goTo(currentPage-1)" aria-label="Previous">‹</button>
            </li>

            <li v-for="p in pageNumbers" :key="p.key"
                class="page-item"
                :class="{ active: p.num === currentPage, disabled: p.ellipsis }">
                <span v-if="p.ellipsis" class="page-link">…</span>
                <button v-else class="page-link" v-on:click ="goTo(p.num)">{{ p.num }}</button>
            </li>

            <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                <button class="page-link" v-on:click="goTo(currentPage+1)" aria-label="Next">›</button>
            </li>
            <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                <button class="page-link" v-on:click="goTo(totalPages)" aria-label="Last">»</button>
            </li>
        </ul>
    </nav>

</div>
<!-- Modal 外框 -->
<div class="modal fade" id="beforeReservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
			<div class="modal-header bg-success">
                <h5 class="modal-title ">預借確認</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="beforeReservationBody"></div>

            <div class="modal-footer">                
                <button type="submit" class="btn btn-primary" form="beforeReservationForm">借書</button>
            </div>
        </div>
    </div>
</div>








<!-- Vue 3 CDN -->
<script src="https://unpkg.com/vue@3.5.22/dist/vue.global.prod.js"></script>   
<script>
    const { createApp, ref, computed, onMounted, watch } = Vue

    createApp({
      setup() {
        const listings = ref([])
        const rowsPerPage = ref(6)
        const perPageOptions = ref([3, 6, 9])
        const currentPage = ref(1)

        function statusText(s) {
          const map = { 0: '可借', 1: '保留中', 2: '已借出' }
          return map[s] ?? s
        }
        function statusBadgeClass(s) {
          const map = { 0: 'bg-success', 1: 'bg-primary', 2: 'bg-warning text-dark' }
          return map[s] ?? 'bg-secondary'
        }

        const totalCount = computed(() => listings.value.length)
        const totalPages = computed(() => Math.max(1, Math.ceil(totalCount.value / rowsPerPage.value)))

        const pagedItems = computed(() => {
          if (currentPage.value > totalPages.value) currentPage.value = totalPages.value
          const start = (currentPage.value - 1) * rowsPerPage.value
          return listings.value.slice(start, start + rowsPerPage.value)
        })

        const pageNumbers = computed(() => {
          const pages = []
          const total = totalPages.value
          const cur = currentPage.value
          const windowSize = 1
          const push = (num) => pages.push({ key: `p-${num}`, num })
          const ellipsis = (key) => pages.push({ key, ellipsis: true })
          if (total <= 7) { for (let i = 1; i <= total; i++) push(i); return pages }
          push(1)
          if (cur > 2 + windowSize) ellipsis('e-left')
          const start = Math.max(2, cur - windowSize)
          const end = Math.min(total - 1, cur + windowSize)
          for (let i = start; i <= end; i++) push(i)
          if (cur < total - 1 - windowSize) ellipsis('e-right')
          push(total)
          return pages
        })

        function goTo(p) {
          currentPage.value = Math.min(Math.max(1, p), totalPages.value)
        }
        watch(rowsPerPage, () => { currentPage.value = 1 })

        async function load() {
          const res = await fetch('/api/listings/front')
          if (!res.ok) { listings.value = []; return }
          listings.value = await res.json()
        }

        // ★ 新增：抽出一個方法用來在成功後更新前端的來源資料
        function applyReservationToList(listingId, newStatus = 1) {
          // 不可變替換，最保險會觸發 re-render
          listings.value = listings.value.map(it =>
            it.listingId === listingId ? { ...it, status: newStatus } : it
          )
        }

        onMounted(load)
        return {
          // 狀態
          listings, rowsPerPage, perPageOptions, currentPage,
          // 計算
          totalCount, totalPages, pagedItems, pageNumbers,
          // 方法與顯示
          goTo, statusText, statusBadgeClass,
          // ★ 新增：暴露給 methods 使用（透過 this.applyReservationToList）
          applyReservationToList
        }
      },

      methods: {
        async openBeforeReservation(listingId) {
          try {
            const resp = await fetch(`/Borrows/Reservations/BeforeReservation?id=${listingId}`, {
              headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            if (!resp.ok) { alert('讀取資料失敗'); return }

            const bodyEl = document.getElementById('beforeReservationBody')
            bodyEl.innerHTML = await resp.text()

            const form = document.getElementById('beforeReservationForm')
            if (!form) { alert('找不到表單'); return }

            // ★ 修改：使用 once: true，避免多次開啟 modal 時重複綁定
            form.addEventListener('submit', async (e) => {
              e.preventDefault()
              const fd = new FormData(form) // 會自動包含 __RequestVerificationToken

              const postResp = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: fd
              })

              if (postResp.status === 400) {
                bodyEl.innerHTML = await postResp.text()
                return
              }
              if (!postResp.ok) { alert('提交失敗'); return }

              const data = await postResp.json()
              if (data?.ok) {
                bootstrap.Modal.getOrCreateInstance(
                  document.getElementById('beforeReservationModal')
                ).hide()

                // ★ 關鍵修改：改成更新 Vue 狀態來源，而不是手動改 DOM
                this.applyReservationToList(data.listingId, data.newStatus ?? 1) // ★ 新增

                // ❌ 移除：以下兩行直接改 DOM（會和 Vue 衝突/無法觸發其他綁定）
                // document.querySelector(`#listing-status-${data.listingId}`)?.replaceChildren(document.createTextNode('保留中'))
                // const btn = document.querySelector(`#reserve-btn-${data.listingId}`); if (btn) { btn.disabled = true; btn.textContent = '已預留' }

                alert(data.message || '預借成功')
              } else {
                alert(data?.message || '發生錯誤')
              }
            }, { once: true }) // ★ 新增

            bootstrap.Modal.getOrCreateInstance(
              document.getElementById('beforeReservationModal')
            ).show()

          } catch {
            alert('發生錯誤，請稍後再試')
          }
        }
      }
    }).mount('#app')
</script>
