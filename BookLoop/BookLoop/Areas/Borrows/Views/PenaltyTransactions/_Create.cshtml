@model BookLoop.ViewModels.PenaltyTransactionsViewModel
@{
    Layout = null;
}
@* 重要：Partial 不要帶 Layout *@
<div class="container">
    <div class="row justify-content-center">

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- 真正提交用的 hidden -->
            <input type="hidden" asp-for="MemberID" />
            <input type="hidden" asp-for="RecordID" />
            <input type="hidden" asp-for="UnitAmount" />  @* 讓 JS 寫入目前單價 *@

            <div class="form-group mb-3 d-flex gap-2 align-items-center">
                <label class="form-label text-nowrap text-center">借閱紀錄ID</label>
                <input class="form-control w-25 text-center" value="@Model.RecordID" disabled />
            </div>

            <div class="form-group mb-3 d-flex gap-2 align-items-center">
                <label class="form-label text-nowrap text-center">借閱人姓名</label>
                <input class="form-control w-25 text-center" value="@Model.MemberName" disabled />
            </div>

            <div class="form-group mb-3 d-flex gap-2 align-items-center">
                <label asp-for="RuleID" class="form-label text-nowrap text-center">規則</label>
                <select asp-for="RuleID"
                        class="form-control w-50 text-center"
                        asp-items="ViewBag.RuleID"
                        id="@Html.IdFor(m => m.RuleID)"
                        data-prices='@Html.Raw(System.Text.Json.JsonSerializer.Serialize((object)ViewBag.UnitAmount))'>
                    <option value="">-- 請選擇 --</option>
                </select>
                <span asp-validation-for="RuleID" class="text-danger"></span>
            </div>

            <div class="form-group mb-3 d-flex gap-2 align-items-center">
                <label asp-for="Quantity" class="form-label text-nowrap text-center">數量</label>
                <input asp-for="Quantity" class="form-control w-50 text-center" min="1" max="300" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="form-group mb-3 d-flex gap-2 align-items-center">
                <label class="form-label text-nowrap text-center ">單價</label>
                <input class="form-control w-50 text-center" id="UnitAmountDisplay" value="@Model.UnitAmount" disabled />
            </div>

            <div class="form-group mb-3 d-flex gap-2 align-items-center">
                <label asp-for="PaidAt" class="form-label text-nowrap text-center">繳清時間</label>
                <input asp-for="PaidAt" class="form-control w-auto" style="min-width: 12ch;" type="date" />
                <span asp-validation-for="PaidAt" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="設定罰金紀錄" class="btn btn-primary" />
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    
}
