@using BookLoop.ViewModels
@model UserDataIndexViewModel


@{
    ViewData["Title"] = "_userdata";
}

<ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="pills-home-tab" data-bs-toggle="pill" data-bs-target="#pills-home"
                type="button" role="tab" aria-controls="pills-home" aria-selected="true">
            借閱紀錄
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pills-profile-tab" data-bs-toggle="pill" data-bs-target="#pills-profile"
                type="button" role="tab" aria-controls="pills-profile" aria-selected="false">
            預約紀錄
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pills-contact-tab" data-bs-toggle="pill" data-bs-target="#pills-contact"
                type="button" role="tab" aria-controls="pills-contact" aria-selected="false">
            罰金紀錄
        </button>
    </li>
</ul>

<div class="tab-content" id="pills-tabContent">
    <div class="tab-pane fade show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab">
        <div id="brIndexHost">
            <div class="text-center py-5" id="brIndexLoading" hidden>
                <div class="spinner-border" role="status" aria-hidden="true"></div>
                <div class="mt-2">載入中…</div>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab">
        <div id="reIndexHost">
            <div class="text-center py-5" id="reIndexLoading" hidden>
                <div class="spinner-border" role="status" aria-hidden="true"></div>
                <div class="mt-2">載入中…</div>
            </div>
        </div>
    </div>
    @* 個人罰金紀錄尚未完成 *@
    <div class="tab-pane fade" id="pills-contact" role="tabpanel" aria-labelledby="pills-contact-tab">
        <div id="peIndexHost">
            <div class="text-center py-5" id="peIndexLoading" hidden>
                <div class="spinner-border" role="status" aria-hidden="true"></div>
                <div class="mt-2">載入中…</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            let loaded = false;

            async function loadBrIndex() {
                if (loaded) return;
                loaded = true;

                const host = document.getElementById('brIndexHost');
                const loading = document.getElementById('brIndexLoading');
                loading.hidden = false;

                // 重要：不帶任何參數，因為 Controller 內已固定 memberId
                const url = '@Url.Action("BrIndexPartial", "BorrowRecords", new { area = "Borrows" })';

                try {
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const html = await res.text();
                    host.innerHTML = html;
                } catch (err) {
                    host.innerHTML = `<div class="alert alert-danger">借閱紀錄載入失敗：${err.message}</div>`;
                }
            }
                // 第二個分頁：預約紀錄
        let loadedReservation = false;

        async function loadReIndex() {
            if (loadedReservation) return;
            loadedReservation = true;

            const host = document.getElementById('reIndexHost');
            const loading = document.getElementById('reIndexLoading');
            loading.hidden = false;

            const url = '@Url.Action("ReIndexPartial", "Reservations", new { area = "Borrows" })';

            try {
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                host.innerHTML = await res.text();
            } catch (err) {
                host.innerHTML = `<div class="alert alert-danger">預約紀錄載入失敗：${err.message}</div>`;
            }
        }

                 // 第三個分頁：罰金紀錄
        let loadedPenalty = false;

        async function loadPeIndex() {
            if (loadedPenalty) return;
            loadedPenalty = true;

            const host = document.getElementById('peIndexHost');
            const loading = document.getElementById('peIndexLoading');
            loading.hidden = false;

            const url = '@Url.Action("PeIndexPartial", "PenaltyTransactions", new { area = "Borrows" })';

            try {
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                host.innerHTML = await res.text();
            } catch (err) {
                host.innerHTML = `<div class="alert alert-danger">罰金紀錄載入失敗：${err.message}</div>`;
            }
        }


            // 當 Home 分頁顯示時載入一次
            document.getElementById('pills-home-tab')?.addEventListener('shown.bs.tab', loadBrIndex);

             document.getElementById('pills-profile-tab')?.addEventListener('shown.bs.tab', loadReIndex);

             document.getElementById('pills-contact-tab')?.addEventListener('shown.bs.tab', loadPeIndex);

            // 如果初始就顯示 Home，立即載入
            if (document.getElementById('pills-home')?.classList.contains('show')) {
                loadBrIndex();
            }
        })();
    </script>
}

