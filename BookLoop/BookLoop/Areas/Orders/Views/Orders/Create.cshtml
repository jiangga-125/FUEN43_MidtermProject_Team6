@model BookLoop.Models.Order

@{
    ViewData["Title"] = "Create";
}
@{
    var statusList = new List<SelectListItem>
    {
        new SelectListItem { Value = "0", Text = "待付款" },
        new SelectListItem { Value = "1", Text = "已下訂" },
        new SelectListItem { Value = "2", Text = "已出貨" },
        new SelectListItem { Value = "3", Text = "完成訂單" },
        new SelectListItem { Value = "4", Text = "已取消" }
    };
}

<h1>新增訂單</h1>

<h4></h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MemberID" class="control-label"></label>
                <select asp-for="MemberID" class="form-control" asp-items="ViewBag.MemberID"></select>
                <span asp-validation-for="MemberID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OrderDate" class="control-label"></label> <span>(必填)</span>
                <input asp-for="OrderDate" class="form-control" type="date" />
                <span asp-validation-for="OrderDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalAmount" class="control-label"></label>
                <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label><span>(必填)</span>
                <select asp-for="Status" class="form-select" asp-items="statusList">
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            @* <div class="form-group">
                <label asp-for="DiscountAmount" class="control-label"></label>
                <input asp-for="DiscountAmount" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="DiscountAmount" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="DiscountCode" class="control-label"></label>
                <input asp-for="DiscountCode" class="form-control" id="discountCodeInput" />
                <span asp-validation-for="DiscountCode" class="text-danger"></span>
                <small id="couponHint" class="text-muted"></small>
            </div>


            @* <div class="form-group">
                <label asp-for="CreatedAt" class="control-label"></label>
                <input asp-for="CreatedAt" class="form-control" />
                <span asp-validation-for="CreatedAt" class="text-danger"></span>
            </div> *@
            @* <div class="form-group">
                <label asp-for="MemberCouponID" class="control-label"></label>
                <input asp-for="MemberCouponID" class="form-control" />
                <span asp-validation-for="MemberCouponID" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="CouponTypeSnap" class="control-label"></label>
                <input id="couponTypeText" class="form-control" readonly />
                <input asp-for="CouponTypeSnap" id="couponTypeInput" type="hidden" />
                <span asp-validation-for="CouponTypeSnap" class="text-danger"></span>
            </div>


            @* <div class="form-group">
                <label asp-for="CouponValueSnap" class="control-label"></label>
                <input asp-for="CouponValueSnap" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="CouponValueSnap" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="CouponNameSnap" class="control-label"></label>
                <input asp-for="CouponNameSnap" class="form-control" />
                <span asp-validation-for="CouponNameSnap" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CouponDiscountAmount" class="control-label"></label> <span>(必填)</span>
                <input asp-for="CouponDiscountAmount" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="CouponDiscountAmount" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">物流公司</label>
                <select name="Provider" class="form-select" required>
                    <option value="">請選擇物流公司</option>
                    <option value="黑貓宅急便">黑貓宅急便</option>
                    <option value="宅配通">宅配通</option>
                    <option value="新竹物流">新竹物流</option>
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary mb-2 mt-3" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">返回訂單列表</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            console.log("✅ Create page script loaded");

        const codeInput = document.getElementById("discountCodeInput");
        const typeInput = document.getElementById("couponTypeInput"); // 隱藏欄位 (int)
        const typeText = document.getElementById("couponTypeText");   // 顯示文字欄位
        const nameInput = document.querySelector("input[name='CouponNameSnap']");
        const valueInput = document.querySelector("input[name='CouponDiscountAmount']");
        const totalInput = document.querySelector("input[name='TotalAmount']");
        const hint = document.getElementById("couponHint");

            if (!codeInput) {
                console.error("❌ 找不到 #discountCodeInput 欄位");
                return;
            }

            codeInput.addEventListener("change", async function () {
                const code = this.value.trim();
                const total = parseFloat(totalInput?.value || 0);
                console.log("🔍 查詢優惠代碼：", code, "總金額：", total);

                if (!code) {
                    typeInput.value = "";
                    nameInput.value = "";
                    valueInput.value = "";
                    hint.innerHTML = "";
                    return;
                }

                try {
                    const res = await fetch(`/api/Store/CouponsApi/GetByCode?code=${encodeURIComponent(code)}&amount=${total}`);

                    // 若伺服器錯誤或404
                    if (!res.ok) {
                        const txt = await res.text();
                        console.error("❌ HTTP錯誤:", res.status, txt);
                        hint.innerHTML = `<span class="text-danger">查詢失敗（HTTP ${res.status}）</span>`;
                        return;
                    }

                    const json = await res.json();
                    console.log("📦 API 回傳：", json);

                    if (!json.success) {
                        hint.innerHTML = `<span class="text-danger">⚠️ ${json.message || "找不到優惠券代碼"}</span>`;
                        typeInput.value = "";
                        nameInput.value = "";
                        valueInput.value = "";
                        return;
                    }

                    const c = json.data;

                    // ✅ 自動帶入資料
                    nameInput.value = c.name || "";
                    typeInput.value = c.discountType === 0 ? "金額折抵" : "百分比折扣";
                    valueInput.value = c.discountValue || 0;

                    // ✅ 顯示提示
                    hint.innerHTML = `
                        <span class="text-success">
                            ✅ 已套用優惠券「${c.name}」（${c.discountType === 0 ? "金額折抵" : "百分比折扣"}）
                        </span>`;
                } catch (err) {
                    console.error("🚨 發生錯誤：", err);
                    hint.innerHTML = `<span class="text-danger">查詢優惠券時發生錯誤</span>`;
                }
            });
        });
    </script>
}

