@model IEnumerable<BookLoop.Models.Order>

@{
    ViewData["Title"] = "Index";
}
@inject BookLoop.Data.MemberContext DbContext
@section Styles {
    <style>
        th.head-width, td.head-width {
            width: 140px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* 訂單滑鼠移上去變色*/
        .table tbody tr:hover {
            background-color: #f0f8ff;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .btn-new {
            width: 200px;
            border: 2px solid #28a745;
            background-color: #eaf9ee;
            color: #28a745;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-new:hover {
                background-color: #28a745;
                color: white;
            }

        .btn-action {
            width: 120px;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

            .btn-action:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.15);
            }
    </style>
}


<div class="text-center">
    <h1 class="border-2">訂單</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="mb-3 text-start">
        <button class="btn btn-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#advancedSearch" aria-expanded="false" aria-controls="advancedSearch">
            進階搜尋
        </button>
    </div>

    <div class="collapse @(
         !string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["searchOrderID"]) ||
         !string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["searchStartDate"]) ||
         !string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["searchEndDate"]) ||
         !string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["searchBookName"])
         ? "show" : "")"
         id="advancedSearch">
        <div class="card card-body mb-3">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-2">
                    <label for="searchStartDate" class="form-label">訂單編號</label>
                    <input type="number" name="searchOrderID" class="form-control" placeholder="OrderID" value="@ViewContext.HttpContext.Request.Query["searchOrderID"]">
                </div>

                <div class="col-md-2">
                    <label for="searchMemberName" class="form-label">會員名稱</label>
                    <input type="text" name="searchMemberName" class="form-control" placeholder="會員名稱" value="@ViewContext.HttpContext.Request.Query["searchMemberName"]">
                </div>

                <div class="col-md-2">
                    <label for="searchMemberID" class="form-label">會員ID</label>
                    <input type="number" name="searchMemberID" class="form-control" placeholder="會員ID" value="@ViewContext.HttpContext.Request.Query["searchMemberID"]">
                </div>

                <div class="col-md-2">
                    <label for="searchStartDate" class="form-label">訂單日期(開始日期)</label>
                    <input type="date" id="searchStartDate" name="searchStartDate" class="form-control" value="@ViewContext.HttpContext.Request.Query["searchStartDate"]">
                </div>

                <div class="col-md-2">
                    <label for="searchEndDate" class="form-label">訂單日期(結束日期)</label>
                    <input type="date" id="searchEndDate" name="searchEndDate" class="form-control" value="@ViewContext.HttpContext.Request.Query["searchEndDate"]">
                </div>
                <div class="col-md-2">
                    <label for="searchStartDate" class="form-label">書籍</label>
                    <input type="text" name="searchBookName" class="form-control" placeholder="書籍名稱" value="@ViewContext.HttpContext.Request.Query["searchBookName"]">
                </div>

                <div class="col-12 mt-2">
                    <button type="submit" class="btn btn-primary w-100">搜尋</button>
                </div>
            </form>
        </div>
    </div>

    <p>
        <a asp-action="Create" class="btn btn-new">新增</a>
    </p>

    <div class="d-flex justify-content-center">
        <table class="table" style="table-layout: fixed; width:100%;">
            <thead>
                <tr>
                    <th class="head-width">@Html.DisplayNameFor(model => model.OrderID)</th>
                    <th class="head-width">@Html.DisplayNameFor(model => model.OrderDate)</th>
                    <th class="head-width">@Html.DisplayNameFor(model => model.TotalAmount)</th>
                    <th class="head-width">@Html.DisplayNameFor(model => model.Status)</th>
                    <th class="head-width">會員ID</th>
                    <th class="head-width">@Html.DisplayNameFor(model => model.DiscountCode)</th>
                    <th class="head-width">@Html.DisplayNameFor(model => model.CouponTypeSnap)</th>
                    <th class="head-width">@Html.DisplayNameFor(model => model.CouponNameSnap)</th>
                    <th class="head-width">@Html.DisplayNameFor(model => model.CouponDiscountAmount)</th>
                    <th class="head-width">會員名稱</th>
                    <th class="head-width">物流資訊</th>
                    @* <th class="head-width">付款資訊</th> *@
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="order-row" data-id="@item.OrderID">
                        <td>@item.OrderID</td>
                        <td>@item.OrderDate.ToString("yyyy/MM/dd")</td>
                        <td>@String.Format("{0:N0} 元", item.TotalAmount)</td>

                        <td>
                            @{
                                string statusText = item.Status switch
                                {
                                    0 => "待付款",
                                    1 => "已付款",
                                    2 => "已出貨",
                                    3 => "完成訂單",
                                    4 => "已取消",
                                    _ => "未知狀態"
                                };

                                string badgeClass = item.Status switch
                                {
                                    0 => "badge bg-warning text-dark",
                                    1 => "badge bg-success",
                                    2 => "badge bg-info text-dark",
                                    3 => "badge bg-primary",
                                    4 => "badge bg-secondary",
                                    _ => "badge bg-dark"
                                };
                            }
                            <span class="@badgeClass">@statusText</span>
                        </td>

                        <td>@item.MemberID</td>
                        <td>@item.DiscountCode</td>
                        <td>@item.CouponTypeSnap</td>

                        @{
                            // 🔍 從優惠券資料庫查出實際優惠券名稱與折扣
                            var couponInfo = item.MemberCouponID != null
                            ? (from mc in DbContext.MemberCoupons
                               join c in DbContext.Coupons on mc.CouponId equals c.CouponId
                               where mc.MemberCouponId == item.MemberCouponID
                               select new
                               {
                                   c.Name,
                                   c.DiscountType,
                                   c.DiscountValue
                               }).FirstOrDefault()
                            : null;

                            string couponName = couponInfo?.Name ?? (string.IsNullOrEmpty(item.CouponNameSnap) ? "未使用優惠券" : item.CouponNameSnap);
                            string discountDisplay = "—";
                            if (couponInfo != null)
                            {
                                discountDisplay = couponInfo.DiscountType == 0
                                ? $"{couponInfo.DiscountValue:N0} 元折抵"
                                : $"{couponInfo.DiscountValue:N0}% 折扣";
                            }
                            else if (item.CouponDiscountAmount > 0)
                            {
                                // 若沒有找回 couponInfo，但有快照折抵金額，顯示快照金額
                                discountDisplay = $"{item.CouponDiscountAmount:N0} 元";
                            }
                        }

                        <td>@couponName</td>
                        <td>@discountDisplay</td>

                        <td>@(item.Member?.Username ?? "無會員")</td>

                        <td>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                                    data-bs-target="#shipmentModal" data-orderid="@item.OrderID">
                                查看物流
                            </button>
                        </td>


                        @* <td>
                            @if (item.Status == 0)
                            {
                                if (item.TotalAmount > 0)
                                {
                                    <form id="paymentForm_@item.OrderID" asp-action="GoToPayment" asp-controller="Orders" method="post" target="_blank">
                                        <input type="hidden" name="orderId" value="@item.OrderID" />
                                        <button type="button" class="btn btn-success btn-action"
                                                onclick="document.getElementById('paymentForm_@item.OrderID').submit();">
                                            前往付款
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary btn-action" disabled title="金額為 0 元，無法付款">
                                        無需付款
                                    </button>
                                 
                                }
                            }
                            else
                            {
                                <span class="text-muted">已付款</span>
                            }
                        </td> *@

                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    ⚙️ 操作
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.OrderID">✏️ 修改</a></li>
                                    <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.OrderID">ℹ️ 詳細資訊</a></li>
                                    <li><a class="dropdown-item" asp-action="OrderDetails" asp-route-id="@item.OrderID">📑 訂單明細</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.OrderID">🗑️ 刪除</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* 分頁 *@
<div class="d-flex justify-content-between align-items-center mt-3">
    @if (ViewBag.TotalCount > 0)
    {
        <div>
            顯示第 @(((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1)
            到 @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalCount)) 筆，
            共 @ViewBag.TotalCount 筆
        </div>
    }
    else
    {
        <div>沒有資料</div>
    }

    <nav>
        <ul class="pagination mb-0">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-searchOrderID="@ViewContext.HttpContext.Request.Query["searchOrderID"]"
                   asp-route-searchCustomerName="@ViewContext.HttpContext.Request.Query["searchCustomerName"]"
                   asp-route-searchCustomerID="@ViewContext.HttpContext.Request.Query["searchCustomerID"]"
                   asp-route-searchStartDate="@ViewContext.HttpContext.Request.Query["searchStartDate"]"
                   asp-route-searchEndDate="@ViewContext.HttpContext.Request.Query["searchEndDate"]"
                   asp-route-searchBookName="@ViewContext.HttpContext.Request.Query["searchBookName"]">上一頁</a>
            </li>

            @{
                int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchOrderID="@ViewContext.HttpContext.Request.Query["searchOrderID"]"
                       asp-route-searchCustomerName="@ViewContext.HttpContext.Request.Query["searchCustomerName"]"
                       asp-route-searchCustomerID="@ViewContext.HttpContext.Request.Query["searchCustomerID"]"
                       asp-route-searchStartDate="@ViewContext.HttpContext.Request.Query["searchStartDate"]"
                       asp-route-searchEndDate="@ViewContext.HttpContext.Request.Query["searchEndDate"]"
                       asp-route-searchBookName="@ViewContext.HttpContext.Request.Query["searchBookName"]">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-searchOrderID="@ViewContext.HttpContext.Request.Query["searchOrderID"]"
                   asp-route-searchCustomerName="@ViewContext.HttpContext.Request.Query["searchCustomerName"]"
                   asp-route-searchCustomerID="@ViewContext.HttpContext.Request.Query["searchCustomerID"]"
                   asp-route-searchStartDate="@ViewContext.HttpContext.Request.Query["searchStartDate"]"
                   asp-route-searchEndDate="@ViewContext.HttpContext.Request.Query["searchEndDate"]"
                   asp-route-searchBookName="@ViewContext.HttpContext.Request.Query["searchBookName"]">下一頁</a>
            </li>
        </ul>
    </nav>
</div>

@* 物流modal *@
<div class="modal fade" id="shipmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">物流資訊</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="shipmentContent">
                載入中...
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            $('#shipmentModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);  // 取得點擊的按鈕
                var orderID = button.data('orderid'); // 從按鈕抓 orderID
                var modal = $(this);

                // 這裡就是放 URL
                var url = '/Orders/Shipments/DetailsByOrder?orderID=' + orderID;

                // 載入 PartialView
                modal.find('#shipmentContent').load(url);
            });

            // 點行列跳轉訂單明細
        $(document).on("click", ".order-row", function (e) {
            // 排除點擊按鈕或 dropdown
            if (!$(e.target).hasClass("btn") && !$(e.target).closest(".dropdown").length) {
                // 直接用 data-url 或 Razor 幫你生成完整 URL
                var url = '@Url.Action("OrderDetails", "Orders", new { area = "Orders", id = "__id__" })';
                url = url.replace("__id__", $(this).data("id"));
                window.location.href = url;
            }
        });
        });
    </script>
}