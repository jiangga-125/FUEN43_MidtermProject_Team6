@model BookLoop.Models.Return

@{
    ViewData["Title"] = "修改退貨";

    var statusList = new List<SelectListItem>
    {
        new SelectListItem { Value = "", Text = "請選擇退貨狀態" },
        new SelectListItem { Value = "0", Text = "申請中" },
        new SelectListItem { Value = "1", Text = "審核中" },
        new SelectListItem { Value = "2", Text = "已出貨" },
        new SelectListItem { Value = "3", Text = "退貨中" },
        new SelectListItem { Value = "4", Text = "已完成" }
    };

    var typeList = new List<SelectListItem>
    {
        new SelectListItem { Value = "", Text = "請選擇退貨類型" },
        new SelectListItem { Value = "0", Text = "整單" },
        new SelectListItem { Value = "1", Text = "單筆" }
    };
}

<h1>修改退貨</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnID" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="OrderID"></label>
                <select asp-for="OrderID" class="form-control" asp-items="@(ViewData["OrderID"] as SelectList)"></select>
                <span asp-validation-for="OrderID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ReturnReason"></label>
                <input asp-for="ReturnReason" class="form-control" />
                <span asp-validation-for="ReturnReason" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ReturnType"></label>
                <select asp-for="ReturnType" class="form-select" asp-items="typeList"></select>
                <span asp-validation-for="ReturnType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status"></label>
                <select asp-for="Status" class="form-select" asp-items="statusList"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ReturnedDate"></label>
                <input asp-for="ReturnedDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="ReturnedDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="儲存" class="btn btn-primary mt-3" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-controller="Returns" asp-action="Index" class="btn btn-secondary mt-3">返回退貨列表</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}