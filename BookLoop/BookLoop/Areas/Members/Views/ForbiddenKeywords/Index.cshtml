@model IEnumerable<BookLoop.Models.ReviewForbiddenKeyword>

@{
    ViewData["Title"] = "禁用詞清單";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-info">@TempData["Msg"]</div>
}

<p>
    <a class="btn btn-primary" asp-controller="ForbiddenKeywords" asp-action="Create">＋新增禁用詞</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>字詞</th>
            <th>嚴重程度</th>
            <th>說明</th>
            <th>狀態</th>
            <th>建立時間</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Keyword</td>
                <td>
                    @if (item.Severity == 1)
                    {
                        <span class="badge bg-warning text-dark">輕微</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">嚴重</span>
                    }
                </td>
                <td>@item.Description</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="text-success fw-bold">啟用</span>
                    }
                    else
                    {
                        <span class="text-muted">停用</span>
                    }
                </td>
                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <form asp-controller="ForbiddenKeywords" asp-action="Toggle" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-warning">
                            @(item.IsActive ? "停用" : "啟用")
                        </button>
                    </form>

                    <a asp-controller="ForbiddenKeywords" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">編輯</a>

                    <form asp-controller="ForbiddenKeywords" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('確定要刪除此禁用詞嗎？')">
                            刪除
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
