@model BookLoop.Models.ViewModels.CreateReviewVm
@{
    ViewData["Title"] = "建立書籍評論";
}
<h1>@ViewData["Title"]</h1>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}

<form asp-area="Members" asp-controller="Reviews" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- 隱藏固定欄位 -->
    <input type="hidden" asp-for="TargetType" value="1" />

    <div class="mb-3">
        <label asp-for="MemberID" class="form-label"></label>
        <input asp-for="MemberID" class="form-control" />
        <span asp-validation-for="MemberID" class="text-danger"></span>
    </div>

    <!-- 書名 -->
    <div class="form-group mb-3">
        <label class="form-label">書名</label>
        <select class="form-select" asp-for="TargetBookID" asp-items="ViewBag.PurchasedBooks">
            <option value="">-- 請選擇您購買過的書籍 --</option>
        </select>
        <span asp-validation-for="TargetBookID" class="text-danger"></span>
    </div>

    <!-- 評分 -->
    <div class="mb-3">
        <label asp-for="Rating" class="form-label">評分</label>
        <select asp-for="Rating" class="form-control">
            <option value="">-- 請選擇評分 --</option>
            <option value="5">⭐⭐⭐⭐⭐</option>
            <option value="4">⭐⭐⭐⭐</option>
            <option value="3">⭐⭐⭐</option>
            <option value="2">⭐⭐</option>
            <option value="1">⭐</option>
        </select>
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>

    <!-- 評論內容 -->
    <div class="mb-3">
        <label asp-for="Content" class="form-label">評論內容</label>
        <textarea asp-for="Content" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <button class="btn btn-primary" type="submit">送出</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
