@model IEnumerable<BookLoop.Models.ViewModels.ReviewModerationUnifiedVM>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "評論審核與檢舉清單";
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - BookLoop</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        main {
            padding: 20px;
            min-height: 70vh;
        }

        footer {
            margin-top: 50px;
            padding: 20px 0;
            background-color: #212529;
            color: #f8f9fa;
            text-align: center;
        }

        .source-badge {
            font-size: 0.9rem;
            padding: 3px 8px;
            border-radius: 6px;
        }

        .source-system {
            background-color: #0d6efd;
            color: white;
        }

        .source-user {
            background-color: #ffc107;
            color: black;
        }
    </style>
</head>
<body>
    <header class="container">
        <h1 class="mt-4">@ViewData["Title"]</h1>
    </header>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["Msg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <main class="container">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>來源</th>
                    <th>評論內容</th>
                    <th>檢舉人</th>
                    <th>原因</th>
                    <th>建立時間</th>
                    <th style="width:180px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            @if (r.Source == "系統審核")
                            {
                                <span class="source-badge source-system">@r.Source</span>
                            }
                            else
                            {
                                <span class="source-badge source-user">@r.Source</span>
                            }
                        </td>
                        <td>@r.Content</td>
                        <td>@r.ReporterName</td>
                        <td>@r.Reason</td>
                        <td>@r.CreatedAt.ToLocalTime()</td>
                        <td class="text-nowrap">
                            <form asp-area="Members" asp-controller="Reviews" asp-action="Approve" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reviewId" value="@r.ReviewID" />
                                <input type="hidden" name="adminId" value="1" />
                                <button type="submit" class="btn btn-sm btn-success">通過</button>
                            </form>

                            <form asp-area="Members" asp-controller="Reviews" asp-action="Reject" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reviewId" value="@r.ReviewID" />
                                <input type="hidden" name="adminId" value="1" />
                                <input type="hidden" name="reason" value="不符合規範" />
                                <button type="submit" class="btn btn-sm btn-danger">駁回</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </main>

    <footer>
        BookLoop © 2025
    </footer>
</body>
</html>
