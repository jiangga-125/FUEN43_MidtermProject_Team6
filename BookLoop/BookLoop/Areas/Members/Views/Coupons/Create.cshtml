@model BookLoop.Areas.Members.ViewModels.CouponEditVm
@{
    ViewData["Title"] = "新增優惠券";
}

<h2>@ViewData["Title"]</h2>

<form asp-area="Members" asp-controller="Coupons" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <!-- 基本欄位：名稱、券碼、折扣類型/值、最低消費、最高折抵、期間、啟用、每會員次數、簡介 -->
    <div>
        <button type="button" id="fillSample" class="btn btn-secondary mb-3">
            <i class="bi bi-magic"></i> 一鍵帶入範例資料
        </button>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Name" class="form-label">名稱</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Code" class="form-label">代碼</label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="DiscountType" class="form-label">折扣類型</label>
            <select asp-for="DiscountType" class="form-select">
                <option value="0">金額折抵</option>
                <option value="1">百分比折扣</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="DiscountValue" class="form-label">折扣值</label>
            <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="DiscountValue" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="MaxDiscountAmount" class="form-label">最高折抵（選填）</label>
            <input asp-for="MaxDiscountAmount" class="form-control" type="number" step="0.01" />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="MinOrderAmount" class="form-label">最低消費（選填）</label>
            <input asp-for="MinOrderAmount" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="MaxUsesPerMember" class="form-label">每會員最多次數（選填）</label>
            <input asp-for="MaxUsesPerMember" class="form-control" type="number" min="0" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="IsActive" class="form-label me-2">啟用</label>
            <input asp-for="IsActive" type="checkbox" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="StartAt" class="form-label">開始時間（選填）</label>
            <input asp-for="StartAt" type="datetime-local" class="form-control"
                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="EndAt" class="form-label">結束時間（選填）</label>
            <input asp-for="EndAt" type="datetime-local" class="form-control" />
        </div>

        <div class="col-12 mb-3">
            <label asp-for="Description" class="form-label">簡介</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="col-12 mb-3">
            <label class="form-label">條款與細則（選填）</label>
            <textarea asp-for="TermsText" class="form-control" rows="4" placeholder="請輸入使用限制、不可併用規則、退貨處理等條款…"></textarea>
        </div>
    </div>

    <!-- ✅ 分類多選：SelectedCategoryIds -->
    <div class="mb-3">
        <label class="form-label">僅限可用分類（可多選）</label>
        <div class="mb-2">
            <input type="checkbox" id="selectAllCategories" class="form-check-input me-2" />
            <label for="selectAllCategories" class="form-check-label">全選（不限制分類）</label>
        </div>
        <select asp-for="SelectedCategoryIds" asp-items="Model.CategoryOptions" class="form-select" multiple size="8"></select>
        <small class="text-muted d-block">按住 Ctrl/Cmd 多選。留空＝不限制分類（全站可用）。</small>
    </div>
    
    <button type="submit" class="btn btn-primary">新增</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 🔹 全選分類
            const selectAll = document.getElementById('selectAllCategories');
            const select = document.querySelector('select[multiple]');
            if (selectAll && select) {
                selectAll.addEventListener('change', () => {
                    Array.from(select.options).forEach(o => o.selected = selectAll.checked);
                });
            }

            // 🔹 一鍵帶入範例資料
            const btn = document.getElementById('fillSample');
            if (btn) {
                btn.addEventListener('click', () => {
                    // 帶入範例資料
                    document.querySelector('[name="Name"]').value = '萬聖節折扣券';
                    document.querySelector('[name="Code"]').value = 'halloween';
                    document.querySelector('[name="DiscountType"]').value = '1';
                    document.querySelector('[name="DiscountValue"]').value = '20';
                    document.querySelector('[name="MaxDiscountAmount"]').value = '200';
                    document.querySelector('[name="MinOrderAmount"]').value = '500';
                    document.querySelector('[name="MaxUsesPerMember"]').value = '2';
                    document.querySelector('[name="IsActive"]').checked = true;
                    document.querySelector('[name="StartAt"]').value = new Date().toISOString().slice(0, 16);

                    const endAt = new Date();
                    endAt.setDate(endAt.getDate() + 7);
                    document.querySelector('[name="EndAt"]').value = endAt.toISOString().slice(0, 16);

                    document.querySelector('[name="Description"]').value = '萬聖節';
                    document.querySelector('[name="TermsText"]').value = '本券僅限一般會員使用，不可與其他優惠併用。';

                    alert('✅ 已自動帶入範例資料！');
                });
            }
        });
                document.querySelector('form').addEventListener('submit', e => {
            console.log('🚀 表單送出事件觸發');
        });
    </script>
}

