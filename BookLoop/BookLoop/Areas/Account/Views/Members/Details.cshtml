@model BookLoop.Member
@{
    ViewData["Title"] = "會員資料";
    bool isBlack = (bool)(ViewBag.IsBlacklisted ?? false);
    string statusText = Model.Status switch { 0 => "未啟用", 1 => "啟用", 2 => "停權", 3 => "關閉", _ => "?" };
}
<h2 class="mb-3 page-title">📄 會員資料</h2>

@await Html.PartialAsync("_Alerts")

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-2">ID</dt>
            <dd class="col-sm-10">@Model.MemberID</dd>
            <dt class="col-sm-2">姓名</dt>
            <dd class="col-sm-10">@Model.Username</dd>
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@Model.Email</dd>
            <dt class="col-sm-2">電話</dt>
            <dd class="col-sm-10">@Model.Phone</dd>
            <dt class="col-sm-2">狀態</dt>
            <dd class="col-sm-10">
                @statusText
                @if (isBlack)
                {
                    <span class="badge bg-danger ms-2">黑名單生效中</span>
                }
            </dd>
            <dt class="col-sm-2">總購買</dt>
            <dd class="col-sm-10">@Model.TotalBooks</dd>
            <dt class="col-sm-2">總借閱</dt>
            <dd class="col-sm-10">@Model.TotalBorrows</dd>
            <dt class="col-sm-2">建立時間</dt>
            <dd class="col-sm-10">@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>
            <dt class="col-sm-2">最後更新</dt>
            <dd class="col-sm-10">@Model.UpdatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a class="btn btn-outline-secondary" asp-action="Index">返回列表</a>
    @if (User.HasClaim("perm", "Members.Edit"))
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.MemberID">編輯</a>
    }
</div>
