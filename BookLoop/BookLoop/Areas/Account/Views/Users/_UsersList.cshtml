@model Account.Controllers.UsersController.UserIndexVM

@{
    string sort = (ViewBag.Sort as string) ?? "id";
    string dir = (ViewBag.Dir as string) ?? "asc";

    bool Is(string key) => sort.Equals(key, System.StringComparison.OrdinalIgnoreCase);
    string Next(string key) => (Is(key) && dir == "asc") ? "desc" : "asc";
    string Arrow(string k) => Is(k) ? (dir == "asc" ? "↑" : "↓") : "";
}

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle list-table">
        <thead>
            <tr>
                <th style="width:90px">
                    <a class="text-dark text-decoration-none ajax-link"
                       asp-action="List" asp-route-sort="id" asp-route-dir="@Next("id")"
                       asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status"
                       asp-route-page="@Model.Page" asp-route-pageSize="@Model.PageSize"># @Arrow("id")</a>
                </th>
                <th>
                    <a class="text-dark text-decoration-none ajax-link"
                       asp-action="List" asp-route-sort="name" asp-route-dir="@Next("name")"
                       asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status"
                       asp-route-page="@Model.Page" asp-route-pageSize="@Model.PageSize">姓名 @Arrow("name")</a>
                </th>
                <th>
                    <a class="text-dark text-decoration-none ajax-link"
                       asp-action="List" asp-route-sort="email" asp-route-dir="@Next("email")"
                       asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status"
                       asp-route-page="@Model.Page" asp-route-pageSize="@Model.PageSize">Email @Arrow("email")</a>
                </th>
                <th>
                    <a class="text-dark text-decoration-none ajax-link"
                       asp-action="List" asp-route-sort="phone" asp-route-dir="@Next("phone")"
                       asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status"
                       asp-route-page="@Model.Page" asp-route-pageSize="@Model.PageSize">電話 @Arrow("phone")</a>
                </th>
                <th>
                    <a class="text-dark text-decoration-none ajax-link"
                       asp-action="List" asp-route-sort="status" asp-route-dir="@Next("status")"
                       asp-route-keyword="@Model.Keyword" asp-route-status="@Model.Status"
                       asp-route-page="@Model.Page" asp-route-pageSize="@Model.PageSize">狀態 @Arrow("status")</a>
                </th>
                <th style="width:260px" class="text-center">操作</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items?.Count > 0)
            {
                foreach (var x in Model.Items)
                {
                    var statusText = x.Status switch { 1 => "啟用", 2 => "停用", 0 => "未啟用", _ => "?" };
                    var badge = x.Status switch { 1 => "bg-success", 2 => "bg-secondary", _ => "bg-light text-dark" };

                    <tr>
                        <td>@x.UserID</td>
                        <td>@(string.IsNullOrWhiteSpace(x.Name) ? "-" : x.Name)</td>
                        <td>@x.Email</td>
                        <td>@(x.Phone ?? "-")</td>
                        <td><span class="badge @badge">@statusText</span></td>
                        <td class="text-center">
                            <div class="d-flex flex-wrap gap-2 justify-content-center">
                                <authorize policy="Users.View">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-area="Account" asp-controller="Users" asp-action="Details" asp-route-id="@x.UserID">
                                        檢視
                                    </a>
                                </authorize>

                                <authorize policy="Users.Edit">
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-area="Account" asp-controller="Users" asp-action="Edit" asp-route-id="@x.UserID">
                                        編輯
                                    </a>
                                </authorize>

                                <authorize policy="Users.Delete">
                                    <button type="button" class="btn btn-sm btn-outline-danger js-del"
                                            data-id="@x.UserID"
                                            data-name="@(string.IsNullOrWhiteSpace(x.Name) ? "-" : x.Name)"
                                            data-email="@x.Email">
                                        刪除
                                    </button>
                                </authorize>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center text-muted">查無資料</td></tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager", (Model.Page, Model.PageSize, Model.Total, sort, dir, Model.Keyword, Model.Status))
