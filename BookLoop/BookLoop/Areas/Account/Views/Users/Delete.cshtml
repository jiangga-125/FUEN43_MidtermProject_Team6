@model BookLoop.User
@{
    ViewData["Title"] = "刪除後台帳號";
    var statusText = Model.Status switch { 0 => "未啟用", 1 => "啟用", 2 => "停用", _ => "?" };
    var typeText = Model.UserType switch { 1 => "顧客", 2 => "員工", 3 => "書商", _ => "?" };
}

<h3 class="mb-3 text-danger">刪除確認</h3>

<div class="alert alert-warning">
    你確定要刪除這個帳號嗎？此動作無法還原。
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">#</dt>
            <dd class="col-sm-10">@Model.UserID</dd>

            <dt class="col-sm-2">名稱</dt>
            <dd class="col-sm-10">@((string.IsNullOrWhiteSpace(Model.Name) ? "-" : Model.Name))</dd>

            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@Model.Email</dd>

            <dt class="col-sm-2">電話</dt>
            <dd class="col-sm-10">@Model.Phone</dd>

            <dt class="col-sm-2">狀態</dt>
            <dd class="col-sm-10">@statusText</dd>

            <dt class="col-sm-2">類型</dt>
            <dd class="col-sm-10">@typeText</dd>
        </dl>
    </div>
</div>

<form class="mt-3" asp-action="Delete" asp-route-id="@Model.UserID" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">確認刪除</button>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">取消</a>
</form>
