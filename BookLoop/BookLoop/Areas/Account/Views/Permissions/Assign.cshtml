@model Account.Controllers.PermissionsController.AssignVM
@{
    Layout = "_Layout";
    ViewData["Title"] = $"適用帳號 - {Model.Perm.PermName ?? Model.Perm.PermKey}";
}

<div class="d-flex align-items-center mb-3">
    <h3 class="mb-0">👥 適用帳號 - @((Model.Perm.PermName ?? Model.Perm.PermKey))</h3>
    <a class="btn btn-outline-secondary ms-auto" asp-area="Account" asp-controller="Permissions" asp-action="Index">返回列表</a>
</div>

@await Html.PartialAsync("_Alerts")

<div class="row g-3">
    <!-- 已指派 -->
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-light fw-semibold">已指派</div>
            <div class="card-body">
                @if (Model.Assigned.Count == 0)
                {
                    <div class="text-muted">尚未指派帳號</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var u in Model.Assigned)
                        {
                            <li class="list-group-item d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@u.Email</div>
                                    @if (!string.IsNullOrWhiteSpace(u.Phone))
                                    {
                                        <div class="text-muted small">@u.Phone</div>
                                    }
                                </div>
                                <authorize policy="Permissions.Assign">
                                    <form method="post" asp-area="Account" asp-controller="Permissions" asp-action="RemoveUser" class="ms-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Perm.PermissionID" />
                                        <input type="hidden" name="userId" value="@u.UserID" />
                                        <button class="btn btn-sm btn-outline-danger">移除</button>
                                    </form>
                                </authorize>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <!-- 候選（搜尋 + 分頁） -->
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex align-items-center">
                <span class="fw-semibold">新增帳號</span>
                <span class="ms-auto text-muted small">共 @Model.Total 筆</span>
            </div>
            <div class="card-body">
                <form method="get" class="row g-2 mb-3" asp-area="Account" asp-controller="Permissions" asp-action="Assign">
                    <input type="hidden" name="id" value="@Model.Perm.PermissionID" />
                    <div class="col">
                        <input name="q"
                               class="form-control"
                               value="@Model.Keyword"
                               placeholder="搜尋（ID / Email / Phone）"
                               oninput="this.form.submit();" />
                    </div>
                </form>

                @if (Model.Candidates.Count == 0)
                {
                    <div class="text-muted">輸入關鍵字開始搜尋或無符合的候選帳號</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var u in Model.Candidates)
                        {
                            <li class="list-group-item d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@u.Email</div>
                                    @if (!string.IsNullOrWhiteSpace(u.Phone))
                                    {
                                        <div class="text-muted small">@u.Phone</div>
                                    }
                                </div>
                                <authorize policy="Permissions.Assign">
                                    <form method="post" asp-area="Account" asp-controller="Permissions" asp-action="AddUser" class="ms-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Perm.PermissionID" />
                                        <input type="hidden" name="userId" value="@u.UserID" />
                                        <button class="btn btn-sm btn-outline-success">新增</button>
                                    </form>
                                </authorize>
                            </li>
                        }
                    </ul>

                    @* 分頁（沿用共用 _Pager，無排序與狀態，帶回 q） *@
                    <div class="mt-3">
                        @await Html.PartialAsync("_Pager", (Model.Page, Model.PageSize, Model.Total, (string?)null, (string?)null, Model.Keyword, (int?)null))
                    </div>
                }
            </div>
        </div>
    </div>
</div>
