@model Account.Controllers.PermissionsController.IndexVM
@{
    ViewData["Title"] = "權限管理";
}

<h2 class="mb-3">🔐 權限管理列表</h2>

@await Html.PartialAsync("_Alerts")

<!-- 搜尋列（與 Users 一致：左關鍵字/每頁筆數，右側「新增」） -->
<form id="filter-form" method="get" class="row g-2 mb-3 align-items-center" autocomplete="off">
    @Html.AntiForgeryToken()

    <div class="col-auto">
        <input id="keyword" name="keyword" class="form-control" placeholder="關鍵字（名稱）" value="@Model.Keyword" style="width:320px;" />
    </div>

    <div class="col-auto">
        @await Html.PartialAsync(
        "_PageSizeSelect",
                viewData: new ViewDataDictionary(ViewData)
                {
                    ["selected"] = Model.PageSize,
                    ["name"] = "pageSize",
                    ["class"] = "form-select js-auto-submit",
                    ["sizes"] = new[] { 10, 20, 50, 100 }
                })
    </div>

    <div class="col-auto ms-auto">
        <authorize policy="Permissions.Create">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPermModal">
                新增權限
            </button>
        </authorize>
    </div>
</form>

<!-- 清單容器（第一次 SSR，之後 AJAX 局部刷新） -->
<div id="list-container">
    @await Html.PartialAsync("_PermissionsList", Model)
</div>

<!-- =============== Modals =============== -->
<!-- 新增權限 Modal（AJAX） -->
<authorize policy="Permissions.Create">
    <div class="modal fade" id="createPermModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <form id="createPermForm" method="post" action="@Url.Action("CreateAjax","Permissions", new { area="Account" })">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">新增權限</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">名稱</label>
                        <input name="name" class="form-control" placeholder="例如：管理員 / 銷售 / 倉儲" required />
                        <div class="form-text">建立後可在列表中重新命名；系統會自動產生 Key。</div>
                        <div id="createErr" class="text-danger small d-none mt-2">建立失敗，請稍後再試。</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                        <button class="btn btn-primary">建立</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</authorize>

<!-- 重新命名（AJAX；需要 Permissions.Edit） -->
<authorize policy="Permissions.Edit">
    <div class="modal fade" id="renameModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <form id="renameForm" method="post" action="@Url.Action("RenameNameAjax","Permissions", new { area="Account" })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="rename_id" />
                    <div class="modal-header">
                        <h5 class="modal-title">重新命名</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">名稱</label>
                        <input class="form-control" name="name" id="rename_name" required />
                        <div id="renameErr" class="text-danger small d-none mt-2">更新失敗，請稍後再試。</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                        <button class="btn btn-primary">儲存</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</authorize>

<!-- 刪除（AJAX；需要 Permissions.Delete） -->
<authorize policy="Permissions.Delete">
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <form id="deleteForm" method="post" action="@Url.Action("DeleteAjax","Permissions", new { area="Account" })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="delete_id" />
                    <div class="modal-header">
                        <h5 class="modal-title">刪除權限</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning mb-0">
                            你即將刪除權限：<strong id="delete_name">-</strong><br />
                            相關指派與功能關聯將一併移除，確定要刪除嗎？
                        </div>
                        <div id="deleteErr" class="text-danger small d-none mt-2">刪除失敗，請稍後再試。</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                        <button class="btn btn-danger">刪除</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</authorize>

@section Scripts {

    @* 共用：清單 AJAX（自動處理搜尋、換頁、排序、History） *@
    @await Html.PartialAsync(
    "_ListAjaxScripts",
        viewData: new ViewDataDictionary(ViewData)
        {
            ["controller"] = "Permissions",
            ["listAction"] = "List",
            ["indexAction"] = "Index",
            ["formId"] = "filter-form",
            ["containerId"] = "list-container"
        })

<script>
    (() => {
      // ====== 便利函式 ======
      function refreshListOrReload() {
        if (window.loadList && window.paramsFromForm) {
          loadList(paramsFromForm());
        } else {
          location.reload();
        }
      }

      // ====== 新增權限（AJAX） ======
      const createForm = document.getElementById('createPermForm');
      if (createForm) {
        const createErr = document.getElementById('createErr');
        createForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          createErr?.classList.add('d-none');

          try {
            const body = new URLSearchParams(new FormData(createForm));
            const resp = await fetch(createForm.action, {
              method: 'POST',
              headers: { 'X-Requested-With': 'XMLHttpRequest' },
              body
            });
            if (!resp.ok) throw new Error('network');
            const data = await resp.json();
            if (!data.ok) throw new Error('create failed');

            bootstrap.Modal.getInstance(document.getElementById('createPermModal'))?.hide();
            createForm.reset();
            refreshListOrReload();
          } catch (err) {
            console.error(err);
            createErr?.classList.remove('d-none');
          }
        });
      }

      // ====== 綁定列表內：開啟重新命名 / 刪除 ======
      document.addEventListener('click', (e) => {
        const renameBtn = e.target.closest('[data-rename-id]');
        if (renameBtn) {
          document.getElementById('rename_id').value   = renameBtn.getAttribute('data-rename-id');
          document.getElementById('rename_name').value = renameBtn.getAttribute('data-rename-name') || '';
          const m = document.getElementById('renameModal');
          if (m) new bootstrap.Modal(m).show();
          return;
        }
        const delBtn = e.target.closest('.js-del');
        if (delBtn) {
          document.getElementById('delete_id').value   = delBtn.getAttribute('data-id');
          document.getElementById('delete_name').textContent = delBtn.getAttribute('data-name') || '-';
          const m = document.getElementById('deleteModal');
          if (m) new bootstrap.Modal(m).show();
          return;
        }
      });

      // ====== 重新命名（AJAX） ======
      const renameForm = document.getElementById('renameForm');
      if (renameForm) {
        const renameErr = document.getElementById('renameErr');
        renameForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          renameErr?.classList.add('d-none');

          try {
            const body = new URLSearchParams(new FormData(renameForm));
            const resp = await fetch(renameForm.action, {
              method: 'POST',
              headers: { 'X-Requested-With': 'XMLHttpRequest' },
              body
            });
            if (!resp.ok) throw new Error('network');
            const data = await resp.json();
            if (!data.ok) throw new Error('rename failed');

            bootstrap.Modal.getInstance(document.getElementById('renameModal'))?.hide();
            refreshListOrReload();
          } catch (err) {
            console.error(err);
            renameErr?.classList.remove('d-none');
          }
        });
      }

      // ====== 刪除（AJAX） ======
      const deleteForm = document.getElementById('deleteForm');
      if (deleteForm) {
        const deleteErr = document.getElementById('deleteErr');
        deleteForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          deleteErr?.classList.add('d-none');

          try {
            const body = new URLSearchParams(new FormData(deleteForm));
            const resp = await fetch(deleteForm.action, {
              method: 'POST',
              headers: { 'X-Requested-With': 'XMLHttpRequest' },
              body
            });
            if (!resp.ok) throw new Error('network');
            const data = await resp.json();
            if (!data.ok) throw new Error('delete failed');

            bootstrap.Modal.getInstance(document.getElementById('deleteModal'))?.hide();
            refreshListOrReload();
          } catch (err) {
            console.error(err);
            deleteErr?.classList.remove('d-none');
          }
        });
      }
    })();
</script>
}
