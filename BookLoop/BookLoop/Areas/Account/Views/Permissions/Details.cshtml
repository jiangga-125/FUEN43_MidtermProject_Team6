@model dynamic
@{
    ViewData["Title"] = "權限詳情";
    string key = (string)(Model.PermKey ?? "");
    string initials = !string.IsNullOrWhiteSpace(key) ? key.Trim().Substring(0, Math.Min(1, key.Trim().Length)).ToUpper() : "P";
    int featureCount = (int)(Model.FeatureCount ?? 0);
    int userCount = (Model.Users as System.Collections.ICollection)?.Count ?? 0;
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-3">
        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:44px;height:44px;font-weight:700;">
            @initials
        </div>
        <div>
            <h3 class="mb-0">權限：@Model.PermKey</h3>
            <div class="text-muted small">ID：@Model.PermissionID</div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">返回列表</a>
        <authorize policy="Permissions.Assign">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.PermissionID">編輯</a>
            <a class="btn btn-success" asp-action="Assign" asp-route-id="@Model.PermissionID">適用帳號</a>
        </authorize>
        <authorize policy="Permissions.Features">
            <a class="btn btn-success" asp-action="Features" asp-route-id="@Model.PermissionID">功能設定</a>
        </authorize>
    </div>
</div>

@await Html.PartialAsync("_Alerts")

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="mb-2 text-muted small">概況</div>
                <div class="d-flex gap-3">
                    <div class="text-center">
                        <div class="fw-bold fs-5">@userCount</div>
                        <div class="text-muted small">帳號數</div>
                    </div>
                    <div class="text-center">
                        <div class="fw-bold fs-5">@featureCount</div>
                        <div class="text-muted small">功能數</div>
                    </div>
                </div>
                <hr />
                <dl class="row mb-0">
                    <dt class="col-4">Key</dt>
                    <dd class="col-8">@Model.PermKey</dd>
                    <dt class="col-4">名稱</dt>
                    <dd class="col-8">@Model.PermName</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <strong>已指派帳號</strong>
            </div>
            <div class="card-body">
                @if (userCount == 0)
                {
                    <div class="text-muted">尚未指派任何帳號。</div>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var u in Model.Users)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@u.Email @((u.Phone != null) ? $" ({u.Phone})" : "")</span>
                                <authorize policy="Permissions.Assign">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Assign" asp-route-id="@Model.PermissionID">管理</a>
                                </authorize>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
