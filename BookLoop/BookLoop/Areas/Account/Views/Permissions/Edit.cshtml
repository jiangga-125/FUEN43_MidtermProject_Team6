@model Account.Controllers.PermissionsController.PermissionFormVm
@{
    ViewData["Title"] = "重新命名權限";
    string initials = !string.IsNullOrWhiteSpace(Model.Key)
        ? Model.Key.Trim().Substring(0, Math.Min(1, Model.Key.Trim().Length)).ToUpper()
        : "P";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-3">
        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
             style="width:44px;height:44px;font-weight:700;">
            @initials
        </div>
        <div>
            <h3 class="mb-0">重新命名權限</h3>
            @if (Model.PermissionID.HasValue)
            {
                <div class="text-muted small">ID：@Model.PermissionID</div>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">返回列表</a>
    </div>
</div>

@await Html.PartialAsync("_Alerts")

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" asp-action="Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PermissionID" />
            <div class="mb-3">
                <label asp-for="Key" class="form-label">名稱（Key）</label>
                <input asp-for="Key" class="form-control" placeholder="例如：ADMIN、VENDOR、SALES" />
                <span class="text-danger" asp-validation-for="Key"></span>
                <div class="form-text">只保留 Key；顯示名稱與 Key 同步。</div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary">儲存</button>
                <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
