@* 通用：列表 AJAX 載入（排序 / 分頁 / 下拉自動提交 / 搜尋） *@
@{
    var controller = (string)(ViewData["controller"] ?? ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    var listAction = (string)(ViewData["listAction"] ?? "List");
    var indexAction = (string)(ViewData["indexAction"] ?? "Index");
    var formId = (string)(ViewData["formId"] ?? "filter-form");
    var containerId = (string)(ViewData["containerId"] ?? "list-container");
    var fixedQuery = (string)(ViewData["fixedQuery"] ?? "");
    var area = (string)(ViewData["area"] ?? ViewContext.RouteData.Values["area"]?.ToString() ?? "");
}

<script>
    (function(){
      const container = document.getElementById('@containerId');
      const form = document.getElementById('@formId');

      if (!container) { console.warn('Container not found: @containerId'); return; }
      if (!form) { console.warn('Form not found: @formId'); return; }

      function buildParams() {
        const params = new URLSearchParams(new FormData(form));
        const fixed = '@fixedQuery'.trim();
        if (fixed) {
          const extra = new URLSearchParams(fixed);
          for (const [k,v] of extra) {
            if (!params.has(k)) params.set(k, v);
          }
        }
        return params;
      }

      async function load(urlOrParams) {
        let params;
        if (typeof urlOrParams === 'string' && urlOrParams.startsWith('http')) {
          const u = new URL(urlOrParams, window.location.origin);
          params = new URLSearchParams(u.search);
        } else if (urlOrParams instanceof URLSearchParams) {
          params = urlOrParams;
        } else {
          params = buildParams();
        }

        // 呼叫部分頁 List（帶 area）
        const listUrl = new URL('@Url.Action((string)ViewData["listAction"] ?? "List", (string)ViewData["controller"] ?? ViewContext.RouteData.Values["controller"]?.ToString(), new { area = (string)(ViewData["area"] ?? ViewContext.RouteData.Values["area"]?.ToString()) })', window.location.origin);
        listUrl.search = params.toString();

        const res = await fetch(listUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' }});
        const html = await res.text();
        container.innerHTML = html;

        // pushState 成整頁 Index（保持相同參數；帶 area）
        const idxUrl = new URL('@Url.Action((string)ViewData["indexAction"] ?? "Index", (string)ViewData["controller"] ?? ViewContext.RouteData.Values["controller"]?.ToString(), new { area = (string)(ViewData["area"] ?? ViewContext.RouteData.Values["area"]?.ToString()) })', window.location.origin);
        idxUrl.search = params.toString();
        history.pushState({}, '', idxUrl);
      }

      // 對外暴露（提供其他腳本呼叫）
      window.loadList = load;
      window.paramsFromForm = buildParams;

      // 表單提交（搜尋）
      form.addEventListener('submit', function(ev){
        ev.preventDefault();
        const p = buildParams();
        p.set('page', '1'); // 搜尋回到第 1 頁
        load(p);
      });

      // select.js-auto-submit 變更 → 第 1 頁
      form.querySelectorAll('select.js-auto-submit').forEach(sel => {
        sel.addEventListener('change', function(){
          const params = buildParams();
          params.set('page', '1');
          load(params);
        });
      });

      // 容器內排序 / 分頁：攔截 .ajax-link
      container.addEventListener('click', function(ev){
        const a = ev.target.closest('a.ajax-link');
        if (!a) return;
        ev.preventDefault();
        load(a.href);
      });

      // 返回鍵：依目前網址參數重載
      window.addEventListener('popstate', function(){
        load(window.location.href);
      });
    })();
</script>
