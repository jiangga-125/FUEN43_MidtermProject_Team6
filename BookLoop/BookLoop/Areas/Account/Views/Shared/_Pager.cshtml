@model (int Page, int PageSize, int Total, string? Sort, string? Dir, string? Keyword, int? Status)

@{
    // 參數整理
    var sortVar = string.IsNullOrWhiteSpace(Model.Sort) ? "id" : Model.Sort!;
    var dirVar = string.Equals(Model.Dir, "desc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";

    // 總頁數
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 20;
    int totalPages = (int)Math.Ceiling((double)Model.Total / pageSize);
    if (totalPages < 1) totalPages = 1;

    // 固定顯示 10 個頁碼
    const int show = 10;                     // 想顯示的頁碼數
    int start = Math.Max(1, Model.Page - 4); // 以當前頁為中心，左邊 4
    int end = Math.Min(totalPages, start + show - 1);
    // 若不足 10 個，往回補
    if (end - start + 1 < show) start = Math.Max(1, end - show + 1);

    // 便利方法
    string pageLink(int p) => Url.Action("List", new
    {
        page = p,
        pageSize = Model.PageSize,
        keyword = Model.Keyword,
        status = Model.Status,
        sort = sortVar,
        dir = dirVar
    })!;
}

@if (totalPages > 1)
{
    <nav class="list-pager py-2" aria-label="pager">
        <ul class="pagination mb-0 justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link ajax-link" href="@(Model.Page > 1 ? pageLink(Model.Page - 1) : "#")">上一頁</a>
            </li>

            @for (int i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link ajax-link" href="@pageLink(i)">@i</a>
                </li>
            }

            <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                <a class="page-link ajax-link" href="@(Model.Page<totalPages? pageLink(Model.Page + 1) : "#")">下一頁</a>
            </li>
        </ul>
    </nav>
}
