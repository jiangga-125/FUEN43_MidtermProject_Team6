@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authz
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - BookLoop</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/account/css/account.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <style>
        body {
            background-color: #f8f9fa;
        }

        .site-footer {
            padding: 20px 0;
            background: #212529;
            color: #f8f9fa;
            text-align: center;
        }

        .navbar-nav .nav-link {
            color: #f8f9fa;
            transition: color .2s, background-color .2s;
            border-radius: 6px;
            padding: 6px 12px;
            margin-right: 5px;
        }

            .navbar-nav .nav-link:hover {
                background: #495057;
                color: #ffc107;
            }

            .navbar-nav .nav-link.active {
                background: #ffc107;
                color: #212529;
                font-weight: bold;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">📚 BookLoop</a>

                <!-- 折疊目標一致 -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNavAccount"
                        aria-controls="navbarNavAccount"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNavAccount">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @{
                            var isAuthed = User?.Identity?.IsAuthenticated ?? false;

                            async Task<bool> AnyAsync(params string[] keys)
                            => isAuthed && (await Task.WhenAll(keys.Select(k => Authz.AuthorizeAsync(User, k))))
                            .Any(r => r.Succeeded);

                            var canUsers = await AnyAsync("Users.View", "Users.Create", "Users.Edit", "Users.Delete");
                            var canPerms = await AnyAsync("Permissions.View", "Permissions.Create", "Permissions.Edit", "Permissions.Delete");
                            var canMembers = await AnyAsync("Members.View", "Members.Create", "Members.Edit", "Members.Delete");
                            var canBlacklists = await AnyAsync("Blacklists.View", "Blacklists.Create", "Blacklists.Edit", "Blacklists.Delete");

                            string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                        }

                        @if (canUsers)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Users" ? "active" : "")"
                                   asp-area="Account" asp-controller="Users" asp-action="Index">👥 後台帳號管理</a>
                            </li>
                        }
                        @if (canPerms)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Permissions" ? "active" : "")"
                                   asp-area="Account" asp-controller="Permissions" asp-action="Index">🔐 權限管理</a>
                            </li>
                        }
                        @if (canMembers)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Members" ? "active" : "")"
                                   asp-area="Account" asp-controller="Members" asp-action="Index">🧑‍🤝‍🧑 會員帳號管理</a>
                            </li>
                        }
                        @if (canBlacklists)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Blacklists" ? "active" : "")"
                                   asp-area="Account" asp-controller="Blacklists" asp-action="Index">⛔ 黑名單管理</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="accountMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountMenu">
                                    <li>
                                        <!-- 修改密碼在根區（非 Area） -->
                                        <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">
                                            修改密碼
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <!-- 強制根區 Auth/Logout，避免變成 /Account/Auth/Logout -->
                                        <form class="px-3" method="post" asp-area="" asp-controller="Auth" asp-action="Logout">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-link p-0">登出</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <!-- 強制根區 Auth/Login -->
                                <a class="btn btn-outline-light" asp-area="" asp-controller="Auth" asp-action="Login">登入</a>
                            </li>
                            <li class="nav-item">
                                <!-- 註冊若在根區也請加 asp-area=""，若在 Account 區就保留你原本設定 -->
                                <a class="btn btn-warning" asp-area="Account" asp-controller="Account" asp-action="Register">註冊</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-fill">
        <div class="container py-3">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <p class="mb-0">© 2025 BookLoop 專案 | FUEN43 Team 6</p>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/account/js/account.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
