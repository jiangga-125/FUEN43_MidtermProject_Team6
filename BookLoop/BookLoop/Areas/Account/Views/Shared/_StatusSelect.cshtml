@* 共用：狀態下拉（支援「全部狀態」；優先用 ViewBag.StatusList） *@
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var name = (string?)ViewData["name"] ?? "status";
    var css = (string?)ViewData["class"] ?? "form-select js-auto-submit";
    var selected = ViewData["selected"]?.ToString(); // 統一用字串
    var includeAll = (bool?)ViewData["includeAll"] ?? false;
    var allText = (string?)ViewData["allText"] ?? "全部狀態";

    IEnumerable<SelectListItem>? fromBag = ViewBag.StatusList as IEnumerable<SelectListItem>;
    IEnumerable<SelectListItem> items = fromBag ?? new[]
    {
        new SelectListItem("啟用","1"),
        new SelectListItem("停用","2"),
    };
}
<select name="@name" class="@css">
    @if (includeAll)
    {
        if (string.IsNullOrEmpty(selected))
        {
            <option value="" selected>@allText</option>
        }
        else
        {
            <option value="">@allText</option>
        }
    }
    @foreach (var it in items)
    {
        var isSel = !string.IsNullOrEmpty(selected) &&
        string.Equals(selected, it.Value, StringComparison.OrdinalIgnoreCase);
        if (isSel)
        {
            <option value="@it.Value" selected>@it.Text</option>
        }
        else
        {
            <option value="@it.Value">@it.Text</option>
        }
    }
</select>
