@model IEnumerable<BookLoop.Models.MailJob>

<h2>群發活動列表</h2>
<p><a asp-action="Create" class="btn btn-primary">新增活動</a></p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>活動名稱</th>
            <th>TemplateKey</th>
            <th>狀態</th>
            <th>建立時間</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CampaignName</td>
                <td>@item.TemplateKey</td>
                <td>@item.Status</td>
                <td>@item.CreatedAt</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.JobId" class="btn btn-sm btn-outline-primary">查看</a>
                    <form asp-area="Mail" asp-controller="MailJobs" asp-action="Cancel"
                          method="post" class="d-inline"
                          onsubmit="return confirm('確定要取消這個批次嗎？');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.JobId" />
                        <button type="submit"
                                class="btn btn-sm btn-outline-danger"
                                @(item.Status == "Scheduled" || item.Status == "Sending" ? "" : "disabled")>
                            取消
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
