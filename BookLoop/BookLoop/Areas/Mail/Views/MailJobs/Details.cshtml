@model BookLoop.Models.MailJob

<h2>@Model.CampaignName</h2>
<p>
    預定：@Model.SendAt:yyyy/MM/dd HH:mm
    ，狀態：<strong>@Model.Status</strong>
    ，進度：<strong>@(ViewBag.Progress)</strong>
    ，起訖：@(Model.StartedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")
    ~ @(Model.FinishedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")
</p>

<h4>名單（部分）</h4>
<table class="table table-sm">
    <thead>
        <tr><th>Email</th><th>姓名</th><th>狀態</th><th>寄出時間</th><th>錯誤</th></tr>
    </thead>
    <tbody>
        @foreach (var r in (IEnumerable<BookLoop.Models.MailJobRecipient>)ViewBag.Recipients)
        {
            <tr>
                <td>@r.RecipientEmail</td>
                <td>@r.RecipientName</td>
                <td>@r.Status</td>
                <td>@(r.SentAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                <td>@r.Error</td>
            </tr>
        }
    </tbody>
</table>

<h4>日誌（近期 200 筆）</h4>
<table class="table table-sm">
    <thead>
        <tr><th>時間</th><th>收件者</th><th>主旨</th><th>狀態</th><th>錯誤</th></tr>
    </thead>
    <tbody>
        @foreach (var l in (IEnumerable<BookLoop.Models.MailSendLog>)ViewBag.Logs)
        {
            <tr>
                <td>@l.SentAt:yyyy/MM/dd HH:mm</td>
                <td>@l.Recipient</td>
                <td>@l.Subject</td>
                <td>@l.Status</td>
                <td>@l.Error</td>
            </tr>
        }
    </tbody>
</table>
