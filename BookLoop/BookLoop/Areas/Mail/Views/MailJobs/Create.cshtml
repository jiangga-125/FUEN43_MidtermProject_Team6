@model BookLoop.Models.MailJob
@{
    ViewData["Title"] = "建立群發活動";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="TemplateId" class="form-label">選擇模板</label>
        <select asp-for="TemplateId" class="form-select" asp-items="@(new SelectList(ViewBag.Templates, "TemplateId", "TemplateKey"))"></select>
    </div>
    <div class="mb-3">
        <label asp-for="TemplateVersionId" class="form-label">版本 ID</label>
        <input asp-for="TemplateVersionId" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="TemplateKey" class="form-label">Template Key</label>
        <input asp-for="TemplateKey" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="CampaignName" class="form-label">活動名稱</label>
        <input asp-for="CampaignName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="SegmentQuery" class="form-label">收件者清單 (以逗號或換行分隔)</label>
        <textarea asp-for="SegmentQuery" rows="5" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="SendAtUtc" class="form-label">寄送時間</label>
        <input asp-for="SendAtUtc" class="form-control" type="datetime-local" />
    </div>

    <button type="submit" class="btn btn-success">建立活動</button>
    <a asp-action="Index" class="btn btn-secondary">返回列表</a>
</form>
