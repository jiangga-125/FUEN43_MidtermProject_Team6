@model BookLoop.Models.MailJob
@{
    ViewData["Title"] = "建立群發活動";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Template -->
            <div class="mb-3">
                <label asp-for="TemplateId" class="form-label">模板群組</label>
                <select asp-for="TemplateId"
                        asp-items="@(ViewBag.TemplateId ?? Enumerable.Empty<SelectListItem>())"
                        class="form-select" id="TemplateId">
                    <option value="">-- 請選擇模板 --</option>
                </select>
                <span asp-validation-for="TemplateId" class="text-danger"></span>
            </div>

            <!-- Template Version -->
            <div class="mb-3">
                <label asp-for="TemplateVersionId" class="form-label">模板版本</label>
                <select asp-for="TemplateVersionId"
                        asp-items="@(ViewBag.TemplateVersionId ?? Enumerable.Empty<SelectListItem>())"
                        class="form-select" id="TemplateVersionId">
                    <option value="">-- 請選擇版本 --</option>
                </select>
                <span asp-validation-for="TemplateVersionId" class="text-danger"></span>
            </div>

            <!-- Campaign Name -->
            <div class="mb-3">
                <label asp-for="CampaignName" class="form-label">活動名稱</label>
                <input asp-for="CampaignName" class="form-control" />
                <span asp-validation-for="CampaignName" class="text-danger"></span>
            </div>

            <!-- SendAt -->
            <div class="mb-3">
                <label asp-for="SendAt" class="form-label">預定發送時間</label>
                <input asp-for="SendAt" class="form-control" type="datetime-local"
                       value="@(Model.SendAt == default ? DateTime.Now.AddMinutes(10).ToString("yyyy-MM-ddTHH:mm") : Model.SendAt.ToString("yyyy-MM-ddTHH:mm"))" />
                <span asp-validation-for="SendAt" class="text-danger"></span>
            </div>

            <!-- Segment Query -->
            <div class="mb-3">
                <label class="form-label">從會員匯入名單</label>
                <div class="input-group">
                    <select id="MemberRoleSelect"
                            class="form-select"
                            asp-items="@(ViewBag.MemberRoles ?? Enumerable.Empty<SelectListItem>())">
                        <option value="">-- 請選擇會員角色 --</option>
                    </select>
                    <button class="btn btn-outline-secondary" type="button" id="ImportMembersBtn">
                        <i class="fas fa-download me-1"></i> 匯入
                    </button>
                </div>
                <div class="form-text">
                    點選「匯入」將會*覆蓋*下方名單欄位。
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="SegmentQuery" class="form-label">名單（每行一筆：email,name）</label>
                <textarea asp-for="SegmentQuery" class="form-control" rows="8" placeholder="a@ex.com,Alice&#10;b@ex.com,Bob"></textarea>
                <span asp-validation-for="SegmentQuery" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">建立</button>
                <a asp-action="Index" class="btn btn-outline-secondary">返回</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
          const tplSel = document.getElementById("TemplateId");
          const verSel = document.getElementById("TemplateVersionId");
          const loadingOption = '<option value="">載入中…</option>';
          const emptyOption = '<option value="">-- 請選擇版本 --</option>';

          async function refreshVersions(templateId, selectedValue) {
            verSel.innerHTML = loadingOption;
            if (!templateId) {
              verSel.innerHTML = emptyOption;
              return;
            }
            try {
              const url = '@Url.Action("GetVersions", "MailJobs", new { area = "Mail" })' + `?templateId=${templateId}`;
              const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
              const data = await res.json();

              verSel.innerHTML = emptyOption;
              data.forEach(v => {
                const opt = document.createElement('option');
                opt.value = v.id;
                opt.textContent = v.text;
                if (selectedValue && String(selectedValue) === String(v.id)) {
                  opt.selected = true;
                }
                verSel.appendChild(opt);
              });
            } catch (e) {
              console.error(e);
              verSel.innerHTML = '<option value="">載入失敗，請重試</option>';
            }
          }

          // 變更 Template → 刷新 Version
          tplSel.addEventListener('change', () => {
            refreshVersions(tplSel.value, null);
          });

          // 首次進頁：如果已有 TemplateId（例如驗證失敗回填），刷新版本並選回 TemplateVersionId
          document.addEventListener('DOMContentLoaded', () => {
            const initTemplateId = tplSel.value;
            const initVersionId = verSel.value;
            if (initTemplateId && (!verSel.options || verSel.options.length <= 1)) {
              refreshVersions(initTemplateId, initVersionId);
            }
            });
        // 匯入Member名單

        // 1. 選取新加入的 HTML 元素
        const roleSel = document.getElementById("MemberRoleSelect");
        const importBtn = document.getElementById("ImportMembersBtn");
        const segmentQueryTa = document.getElementById("SegmentQuery"); // asp-for="SegmentQuery" 會自動產生此 ID

        // 2. 幫「匯入」按鈕加上點擊事件
        importBtn.addEventListener('click', async () => {
            const selectedRole = roleSel.value;
            if (!selectedRole) {
                alert('請先選擇一個會員角色。');
                return;
            }

            // 3. 禁用按鈕，避免重複點擊
            importBtn.disabled = true;
            importBtn.innerHTML = '匯入中...';

            try {
                // 4. 呼叫 Controller 的 GetMembersByRole 動作 (AJAX)
                const url = '@Url.Action("GetMembersByRole", "MailJobs", new { area = "Mail" })' + `?role=${selectedRole}`;
                const res = await fetch(url, { headers: { 'Accept': 'application/json' } });

                if (!res.ok) {
                    throw new Error(`伺服器錯誤: ${res.status}`);
                }

                const members = await res.json();

                if (members.length === 0) {
                    alert('找不到該角色的會員，或者這些會員沒有 Email。');
                    segmentQueryTa.value = ''; // 清空
                    return;
                }

                // 5. 核心：將 JSON 資料轉換為 "email,username" 格式
                const memberLines = members.map(m => `${m.email},${m.username}`);

                // 6. 將組合好的字串填入 textarea
                segmentQueryTa.value = memberLines.join('\n'); // 用換行符號組合

                alert(`成功匯入 ${members.length} 筆會員資料。`);

            } catch (e) {
                console.error('Failed to import members:', e);
                alert('匯入失敗，請查看 console log。');
            } finally {
                // 7. 無論成功或失敗，都恢復按鈕
                importBtn.disabled = false;
                importBtn.innerHTML = '<i class="fas fa-download me-1"></i> 匯入';
            }
          });
        })();


    </script>
}
