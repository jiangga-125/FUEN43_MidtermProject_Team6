@* 開發用：看長度 *@
<!-- DesignJson length: @(Model?.DesignJson?.Length ?? 0) -->
@model BookLoop.Models.MailTemplate
@{
    ViewData["Title"] = "編輯郵件範本（Unlayer）";
}

@section Styles {
    <style>
        .unlayer-editor {
            height: calc(100vh - 260px); /* 視窗高-上方欄位與邊距 */
            min-height: 560px;
            border: 1px solid #e5e5e5;
            border-radius: .5rem;
            background: #fff;
        }

        .preview-frame {
            height: calc(100vh - 260px);
            min-height: 560px;
            background: #fff;
        }

        .side-note {
            font-size: .85rem;
            color: #6c757d
        }
    </style>
}

<div class="container-fluid mt-4">
    <h1 class="mb-3">@ViewData["Title"]</h1>
    <div class="row g-3">
        <!-- 左：表單（欄位 + 儲存） + 編輯器 -->
        <div class="col-xl-8 col-lg-7">
            <form asp-action="Edit" id="form-basic">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TemplateID" id="TemplateID" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="row g-2 align-items-end">
                    <div class="col-12">
                        <label asp-for="TemplateKey" class="form-label">範本識別碼</label>
                        <!-- 唯讀顯示（disabled 不會回送，下面用 hidden 回送值） -->
                        <select asp-for="TemplateKey" class="form-select" asp-items="ViewBag.TemplateKeyList" disabled>
                            <option value="">-- 請選擇範本 Key --</option>
                        </select>
                        <input type="hidden" asp-for="TemplateKey" />
                        <span asp-validation-for="TemplateKey" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Subject" class="form-label">郵件主旨</label>
                        <input asp-for="Subject" class="form-control" />
                        <span asp-validation-for="Subject" class="text-danger"></span>
                    </div>
                </div>

                <!-- Hidden：Unlayer 匯出 -->
                <input type="hidden" asp-for="BodyHtml" id="Html" />
                <input type="hidden" asp-for="DesignJson" id="DesignJson" />
            </form>

            <div id="editor" class="unlayer-editor mt-3"></div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">範本說明</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="col-12 d-flex align-items-center justify-content-between">
                <div class="form-check">
                    <input class="form-check-input" asp-for="IsActive" id="IsActive" />
                    <label class="form-check-label" for="IsActive">啟用</label>
                </div>
                <button type="button" class="btn btn-primary" id="btn-save-all">儲存</button>
            </div>
        </div>

        <!-- 右：試寄（在上方） + 預覽 -->
        <div class="col-xl-4 col-lg-5">
            <div class="d-flex align-items-center justify-content-between">
                <h6 class="mb-0">試寄</h6>
                <button type="button" class="btn btn-sm btn-outline-primary" id="btn-test-send">送出測試</button>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-8"><input id="pv-recipient" class="form-control form-control-sm" placeholder="recipient@example.com" /></div>
                <div class="col-4"><input id="pv-name" class="form-control form-control-sm" placeholder="Name" /></div>
            </div>
            <div class="side-note mt-2">可用變數：<code>{{Recipient}}</code>、<code>{{Name}}</code></div>

            <div class="d-flex align-items-center justify-content-between mt-3">
                <h6 class="mb-0">預覽</h6>
                <div class="side-note">主旨：<span id="pv-subject"></span></div>
            </div>
            <iframe id="pv-frame" class="w-100 border rounded preview-frame mt-2"></iframe>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://editor.unlayer.com/embed.js"></script>
    <script src="~/js/unlayer-mail.js" asp-append-version="true"></script>
    <script>
        UnlayerMail.init({
          mode: 'edit',
          formId: 'form-basic',
          editorId: 'editor',
          subjectSelector: '[name="Subject"]',
          subjectOutSelector: '#pv-subject',
          designFieldId: 'DesignJson',
          htmlFieldId: 'Html',
          previewFrameId: 'pv-frame',
          recipientSelector: '#pv-recipient',
          nameSelector: '#pv-name',
          saveButtonSelector: '#btn-save-all',
          testButtonSelector: '#btn-test-send',
          testSendUrl: '@Url.Action("TestSend", "MailTemplates", new { area = "Mail" })',
          uploadUrl: '@Url.Action("Upload", "Assets", new { area = "Mail" })',
          antiForgery: document.querySelector('#form-basic input[name="__RequestVerificationToken"]').value
        });
    </script>
}
