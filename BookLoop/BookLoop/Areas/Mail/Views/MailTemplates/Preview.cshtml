@{
    Layout = "_Layout";
    var subject = ViewBag.Subject as string ?? "";
    var rawHtml = ViewBag.RawHtml as string ?? "";
    var templateId = (int)ViewBag.TemplateId;
}
<h2>模板預覽</h2>

<form method="get" class="row g-2 mb-3" asp-action="Preview" asp-route-id="@templateId">
    <div class="col-auto">
        <input class="form-control" name="recipient" placeholder="recipient@example.com"
               value="@Context.Request.Query["recipient"]" />
    </div>
    <div class="col-auto">
        <input class="form-control" name="Name" placeholder="Name"
               value="@Context.Request.Query["Name"]" />
    </div>
    <div class="col-12 col-md-6">
        <input class="form-control" name="OrderNo" placeholder="OrderNo(可選)"
               value="@Context.Request.Query["OrderNo"]" />
    </div>
    <div class="col-12"><button class="btn btn-primary">重新預覽</button></div>
</form>

<div class="mb-2"><strong>Subject：</strong>@subject</div>

<div class="border p-3 bg-white">
    @Html.Raw(rawHtml)
</div>

<hr />
<h5>試寄</h5>
<form method="post" asp-action="TestSend" class="row g-2">
    <input type="hidden" name="id" value="@templateId" />
    <div class="col-12 col-md-4">
        <input class="form-control" name="to" placeholder="收件者 Email"
               value="@Context.Request.Query["recipient"]" />
    </div>
    <div class="col-12 col-md-4">
        <input class="form-control" name="name" placeholder="Name（可選）"
               value="@Context.Request.Query["Name"]" />
    </div>
    <div class="col-12">
        <textarea class="form-control" name="tokenJson" rows="4"
                  placeholder='可選：JSON 變數，例如 {"UserName":"小王","Link":"https://..."}'></textarea>
    </div>
    <div class="col-12"><button class="btn btn-success">送出測試郵件</button></div>
</form>

@if (TempData["ok"] is string ok)
{
    <div class="alert alert-success mt-3">@ok</div>
}
