@model BookLoop.Models.TemplateVersion
@{
    ViewData["Title"] = $"編輯版本：{Model.TemplateName}";
}

@section Styles {
    <style>
        .unlayer-editor {
            height: calc(100vh - 260px);
            min-height: 560px; /* */
            border: 1px solid #e5e5e5;
            border-radius: .5rem;
            background: #fff; /* */
        }

        .preview-frame {
            height: calc(100vh - 260px);
            min-height: 560px; /* */
            background: #fff;
        }

        .side-note {
            font-size: .85rem;
            color: #6c757d; /* */
        }
    </style>
}

<div class="container-fluid mt-4">
    <h1 class="mb-3">@ViewData["Title"]</h1>
    <div class="row g-3">
        <!-- 左：表單 + 編輯器 -->
        <div class="col-xl-8 col-lg-7">
            <form asp-action="Edit" asp-controller="TemplateVersions" asp-area="Mail" id="form-basic">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <input type="hidden" asp-for="TemplateVersionId" /> <input type="hidden" asp-for="TemplateId" />
                <input type="hidden" asp-for="BodyHtml" id="Html" />
                <input type="hidden" asp-for="DesignJson" id="DesignJson" />

                <div class="row g-2">

                    <div class="col-12">
                        <label asp-for="TemplateName" class="form-label">版本名稱</label>
                        <input asp-for="TemplateName" class="form-control" />
                        <span asp-validation-for="TemplateName" class="text-danger"></span>
                    </div> 
                    <div class="col-12">
                        <label asp-for="Subject" class="form-label">郵件主旨</label>
                        <input asp-for="Subject" class="form-control" />
                        <span asp-validation-for="Subject" class="text-danger"></span>
                    </div>
                    <div class="col-12 d-flex align-items-center justify-content-between">
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="IsActive" id="IsActive" />
                                <label class="form-check-label" for="IsActive">啟用</label>
                            </div> <div class="form-check">
                                <input class="form-check-input" asp-for="IsDefault" id="IsDefault" />
                                <label class="form-check-label" for="IsDefault">設為預設版本</label>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
            <div id="editor" class="unlayer-editor mt-3"></div>
            <div class="mt-3 d-flex justify-content-between">
                <a class="btn btn-link"
                   asp-area="Mail" asp-controller="TemplateVersions" asp-action="Index" asp-route-templateId="@Model.TemplateId">← 返回版本列表</a>
                <button type="button" class="btn btn-primary" id="btn-save-all">儲存</button>
            </div>
        </div>
        <!-- 右：試寄 + 預覽 -->
        <div class="col-xl-4 col-lg-5">
            <div class="d-flex align-items-center justify-content-between">
                <h6 class="mb-0">測試發信</h6>
                <button type="button" class="btn btn-sm btn-outline-primary" id="btn-test-send">送出測試</button>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-8"><input id="pv-recipient" class="form-control form-control-sm" placeholder="recipient@example.com" /></div>
                <div class="col-4"><input id="pv-name" class="form-control form-control-sm" placeholder="Name" /></div>
            </div>

            <div class="d-flex align-items-center justify-content-between mt-3">
                <h6 class="mb-0">預覽</h6>
                <div class="side-note">主旨：<span id="pv-subject"></span></div>
            </div> <iframe id="pv-frame" class="w-100 border rounded preview-frame mt-2"></iframe>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial"); 
    }
    <script src="https://editor.unlayer.com/embed.js"></script>
    <script src="~/js/unlayer-mail.js" asp-append-version="true"></script>
    <script>
        // 初始化 (Edit 模式)
        UnlayerMail.init({
          mode: 'edit', 
          formId: 'form-basic',
          editorId: 'editor',
          subjectSelector: '[name="Subject"]',
          subjectOutSelector: '#pv-subject',
          designFieldId: 'DesignJson',   
          htmlFieldId: 'Html', 
          previewFrameId: 'pv-frame',
          recipientSelector: '#pv-recipient',
          nameSelector: '#pv-name',
          saveButtonSelector: '#btn-save-all',
          testButtonSelector: '#btn-test-send',
          // API URLs (注意：Action 和 Route 參數與 Create 不同)
          testSendUrl: '@Url.Action("TestSend", "TemplateVersions", new { area = "Mail", templateId = Model.TemplateId })',
          uploadUrl:   '@Url.Action("Upload", "TemplateVersions", new { area = "Mail", templateId = Model.TemplateId })', 
          antiForgery: document.querySelector('#form-basic input[name="__RequestVerificationToken"]').value 
        }); 
    </script>
}