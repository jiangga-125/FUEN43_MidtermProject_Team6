@model BookLoop.Models.MailSendLog
@{
    ViewData["Title"] = "寄送明細";

    string DT(DateTime? dt) => dt.HasValue ? dt.Value.ToString("yyyy/MM/dd HH:mm") : "-";
    Func<string?, string> statusBadge = s => s switch
    {
        "pending" => "badge bg-secondary",
        "Sent" => "badge text-bg-success",
        "Failed" => "badge text-bg-danger",
        _ => "badge text-bg-secondary"
    };
    string StatusText(string? s) => s switch
    {
        "pending" => "待寄送",
        "Sent" => "已寄出",
        "Failed" => "失敗",
        _ => s ?? "未知"
    };
}

<div class="container mt-4">
    <h1 class="mb-3">寄送明細</h1>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header">基本資訊</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-4">LogId</dt>
                        <dd class="col-8">@Model.LogId</dd>
                        <dt class="col-4">時間</dt>
                        <dd class="col-8">@Model.SentAt</dd>
                        <dt class="col-4">收件者</dt>
                        <dd class="col-8">@Model.Recipient</dd>
                        <dt class="col-4">主旨</dt>
                        <dd class="col-8">@Model.Subject</dd>
                        <dt class="col-4">狀態</dt>
                        <dd class="col-8">
                            <span class="@statusBadge(Model.Status)">@StatusText(Model.Status)</span>
                        </dd>
                        @if (!string.IsNullOrWhiteSpace(Model.Error))
                        {
                            <dt class="col-4 text-danger">錯誤</dt>
                            <dd class="col-8 text-danger">@Model.Error</dd>
                        }
                        <dt class="col-4">TemplateId</dt>
                        <dd class="col-8">@Model.TemplateId</dd>
                        <dt class="col-4">TemplateKey</dt>
                        <dd class="col-8">@Model.TemplateKey</dd>
                        <dt class="col-4">TemplateVersionId</dt>
                        <dd class="col-8">@Model.TemplateVersionId</dd>
                        <dt class="col-4">ProviderMsgId</dt>
                        <dd class="col-8">@Model.ProviderMsgId</dd>
                    </dl>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">返回</a>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="mb-0">實際預覽</h5>
            </div>

            <iframe id="previewFrame" class="w-100 border rounded"
                    style="height:650px;background:#fff"></iframe>

            <textarea id="__snapshot" hidden>@Model.BodySnapshot</textarea>

        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-header {
            font-weight: 600;
        }

        iframe {
            box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,.06);
        }
    </style>
}

@section Scripts {
    <script>
        try {
            const frame = document.getElementById('previewFrame');
            const snapshot = document.getElementById('__snapshot');

            if (frame && snapshot) {
                // 1. 從 textarea 讀取 HTML
                // .value 會自動 "HTML-decode" 內容
                const fullHtml = snapshot.value || '';
                let content = fullHtml;

                // 2. 在 JavaScript 中使用 Regex 提取 <body> 內容
                //    (?s) 在 C# 中需要，但在 JS 中要用 [\s\S] (包含換行符)
                const match = fullHtml.match(/<body[^>]*>([\s\S]*?)<\/body>/i);

                if (match && match[1]) {
                    // 成功提取，只使用 <body> 內的內容
                    content = match[1];
                }
                // 如果 Regex 提取失敗，'content' 仍然是 'fullHtml'
                // 這將導致預覽失敗，但至少我們嘗試過了

                // 3. 將提取的內容寫入 iframe
                const doc = frame.contentWindow.document;
                doc.open();
                doc.write(content);
                doc.close();
            }
        } catch (e) {
            console.error("預覽 iframe 載入失敗:", e);
        }
    </script>
}