@* /Views/Shared/_Layout.Admin.cshtml *@
@{
    Layout = null;
    var appTitle = "BookLoop 後台";
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@appTitle</title>

    <!-- Bootstrap / Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" /> *@

    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @* 可選的 Styles 區塊（view 可用 @section Styles { ... } 注入） *@
    @RenderSection("Styles", required: false)

    <style>
        /* [NEW] 讓自製 submenu 有顯示/隱藏的行為（配合你 sidebar 的 data-toggle 用） */
        .submenu {
            display: none;
        }

            .submenu.show {
                display: block;
            }
    </style>

    @* 額外的 head 注入點（例如 meta 或 head-level scripts），視需要開放給 view 使用。若不需要可刪掉此行。 *@
    @RenderSection("Head", required: false)
</head>
<body>
    <div class="d-flex min-vh-100">
        <aside class="sidebar flex-shrink-0">
            @await Html.PartialAsync("_AdminSidebar")
        </aside>

        <main class="flex-fill">
            @await Html.PartialAsync("_AdminTopbar")

            <div class="container-fluid py-3">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // [NEW] 防止 href="#" 造成跳到頁面頂部
        document.querySelectorAll('a[href="#"]').forEach(function (a) {
            a.addEventListener('click', function (e) { e.preventDefault(); });
        });

        // [KEEP][精簡] 讓你的 data-toggle="submenu" 能展開/收合指定的 .submenu
        document.addEventListener("click", function (e) {
            var trigger = e.target.closest("[data-toggle='submenu']");
            if (!trigger) return;
            var id = trigger.getAttribute("data-target");
            if (!id) return;
            var pane = document.querySelector(id);
            if (pane) pane.classList.toggle("show");
        });

        // [NEW] 若頁面上也有 Bootstrap 的 dropdown/collapse（使用 data-bs-*），保守初始化一下
        document.querySelectorAll("[data-bs-toggle='dropdown']").forEach(function (el) {
            try { new bootstrap.Dropdown(el); } catch (err) { }
        });
        document.querySelectorAll("[data-bs-toggle='collapse']").forEach(function (el) {
            var target = el.getAttribute('data-bs-target') || el.getAttribute('href');
            if (target && target !== '#') {
                var pane = document.querySelector(target);
                if (pane) { try { new bootstrap.Collapse(pane, { toggle: false }); } catch (err) { } }
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
