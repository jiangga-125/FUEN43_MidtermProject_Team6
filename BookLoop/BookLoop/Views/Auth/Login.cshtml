@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;

    // 一鍵登入用帳密
    var demoEmail = "admin@bookstore.local";
    var demoPassword = "Admin@12345!";

    var demoEmail2 = "book.service@bookstore.local";
    var demoPassword2 = "bookloop";
}

<!doctype html>

<html lang="zh-Hant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>BookLoop 後台 - 登入</title>

    <!-- Bootstrap 5 + Icons (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --admin-bg-1: #071029;
            --admin-bg-2: #0b3b5a;
            --card-bg: rgba(255,255,255,0.04);
            --card-border: rgba(255,255,255,0.06);
            --muted: rgba(255,255,255,0.7);
            --accent: #06a1cc;
            --accent-2: #08799e;
            --danger-bg: rgba(255,100,100,0.06);
        }

        html, body {
            height: 100%;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg,var(--admin-bg-1),var(--admin-bg-2));
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Noto Sans TC", "Segoe UI", Roboto, "PingFang TC", "Microsoft JhengHei", sans-serif;
            color: #fff;
        }

        /* Container & Card */
        .auth-container {
            width: min(520px, 94%);
            padding: 12px;
        }

        .auth-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 26px;
            box-shadow: 0 12px 36px rgba(2,6,23,0.6);
            color: #fff;
        }

        /* Brand */
        .auth-brand {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 14px;
        }

            .auth-brand img {
                width: 56px;
                height: 56px;
                border-radius: 8px;
                object-fit: cover;
            }

            .auth-brand h4 {
                margin: 0;
                font-size: 1.05rem;
            }

            .auth-brand .muted {
                margin-top: 4px;
                color: var(--muted);
                font-size: 0.9rem;
            }

        /* Form controls */
        .auth-card .form-control {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            color: #fff;
            height: 44px;
            padding: 10px 12px;
            border-radius: 8px;
        }

            .auth-card .form-control::placeholder {
                color: rgba(255,255,255,0.58);
            }

        .input-group .input-group-text {
            background: transparent;
            border: none;
            color: rgba(255,255,255,0.92);
        }

        /* Buttons */
        .btn-primary {
            background: linear-gradient(90deg,var(--accent-2),var(--accent));
            border: none;
            height: 46px;
            border-radius: 10px;
            font-weight: 600;
        }

        .btn-outline-light {
            color: #fff;
            border-radius: 8px;
        }

        .btn-demo {
            background: linear-gradient(90deg,#ffb86b,#ff7a59);
            border: none;
            color: #111;
            height: 40px;
            border-radius: 8px;
            padding: 0 12px;
        }

        /* Footer links */
        .auth-footer {
            margin-top: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

            .auth-footer a {
                color: var(--muted);
                text-decoration: none;
                font-size: 0.9rem;
            }

                .auth-footer a:hover {
                    color: #fff;
                    text-decoration: underline;
                }

        /* Alerts */
        .auth-card .alert {
            background: var(--danger-bg);
            color: #ffdddd;
            border: 1px solid rgba(255,120,120,0.12);
            padding: 8px 10px;
            border-radius: 8px;
        }

        /* Small screens */
        @@media (max-width: 480px) {
            .auth-brand img {
                width: 48px;
                height: 48px;
            }

            .auth-card {
                padding: 18px;
            }
        }
    </style>
</head>

<body>
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="mb-3 text-center">後台登入</h4>

                    <!-- 一般登入 -->
                    <form method="post" asp-controller="Auth" asp-action="Login" autocomplete="on" class="mb-3">
                        @Html.AntiForgeryToken()
                        @if (!string.IsNullOrEmpty(returnUrl))
                        {
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                        }

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input name="email" type="email" class="form-control" required autofocus autocomplete="username" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input name="password" type="password" class="form-control" required autocomplete="current-password" />
                        </div>

                        <button class="btn btn-primary w-100">登入</button>
                    </form>

                    <!-- 分隔線 -->
                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1" />
                        <span class="px-2 text-muted" style="font-size: .9rem;">或</span>
                        <hr class="flex-grow-1" />
                    </div>

                    <!-- 一鍵登入（Admin） -->
                    <form method="post" asp-controller="Auth" asp-action="Login" class="d-grid gap-2 mb-3">
                        @Html.AntiForgeryToken()
                        @* 將帳密直接放 hidden；參數名稱需對應 AuthController.Login 接收的名稱 *@
                        <input type="hidden" name="email" value="@demoEmail" />
                        <input type="hidden" name="password" value="@demoPassword" />
                        @if (!string.IsNullOrEmpty(returnUrl))
                        {
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                        }
                        <button type="submit" class="btn btn-outline-dark w-100" title="僅供報告/測試環境快速登入">
                            一鍵登入（管理員）
                        </button>
                    </form>

                    <form method="post" asp-controller="Auth" asp-action="Login" class="d-grid gap-2">
                        @Html.AntiForgeryToken()
                        @* 將帳密直接放 hidden；參數名稱需對應 AuthController.Login 接收的名稱 *@
                        <input type="hidden" name="email" value="@demoEmail2" />
                        <input type="hidden" name="password" value="@demoPassword2" />
                        @if (!string.IsNullOrEmpty(returnUrl))
                        {
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                        }
                        <button type="submit" class="btn btn-outline-dark w-100" title="僅供報告/測試環境快速登入">
                            一鍵登入（權限）
                        </button>
                    </form>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="text-danger mt-3">
                            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@e.ErrorMessage</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</body>

</html>
