@{
    ViewBag.Title = "後台儀表板";
}
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12 d-flex align-items-center">
            <!-- 搜尋列（可保留） -->
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card p-3">
                <div class="small text-muted">今日訂單數</div>
                <div id="todayOrderCount" class="h4">--</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="small text-muted">今日營收</div>
                <div id="todayRevenue" class="h4">NT$ --</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="small text-muted">未出貨</div>
                <div id="unshippedCount" class="h4">--</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="small text-muted">庫存告警</div>
                <div id="inventoryAlerts" class="h4">--</div>
            </div>
        </div>
    </div>

    <div class="row mt-3 g-3">
        <div class="col-lg-8">
            <div class="card p-3">
                <div class="d-flex justify-content-between">
                    <div class="fw-medium">近 14 天銷售走勢</div>
                    <div>
                        <select id="salesType" class="form-select form-select-sm">
                            <option value="revenue">營收</option>
                            <option value="orders">訂單數</option>
                        </select>
                    </div>
                </div>
                <canvas id="mySalesChart" height="120"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card p-3">
                <div class="fw-medium mb-2">最新訂單</div>
                <div id="latestOrdersList" class="list-group"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>
        (function(){
          let salesChart;

          async function fetchSummary(){
            try {
              const rsp = await fetch('/api/dashboard/summary');
              if(!rsp.ok) throw new Error('network');
              const json = await rsp.json();

              document.getElementById('todayOrderCount').textContent = json.todayOrderCount ?? 0;
              document.getElementById('todayRevenue').textContent = 'NT$ ' + (json.todayRevenue ?? 0).toLocaleString();
              document.getElementById('unshippedCount').textContent = json.unshippedCount ?? 0;
              document.getElementById('inventoryAlerts').textContent = json.inventoryAlerts ?? 0;

              const list = document.getElementById('latestOrdersList');
              list.innerHTML = '';
              (json.latestOrders || []).forEach(o => {
                const a = document.createElement('a');
                a.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                a.href = '/Orders/Details/' + (o.Id || o.id || o.OrderId || o.orderId);
                a.innerHTML = `<div><strong>${o.Id || o.id || o.OrderId || o.orderId}</strong><div class="text-muted small">${o.Member||''}</div></div>
                               <div class="text-end">${(o.TotalAmount||o.totalAmount||0).toLocaleString()}</div>`;
                list.appendChild(a);
              });

            } catch (e) {
              console.error('fetchSummary err', e);
            }
          }

          async function fetchSales(){
            try {
              const rsp = await fetch('/api/dashboard/sales14');
              if(!rsp.ok) throw new Error('network');
              const j = await rsp.json();

              const ctx = document.getElementById('mySalesChart').getContext('2d');
              if(salesChart) salesChart.destroy();
              salesChart = new Chart(ctx, {
                type: 'line',
                data: {
                  labels: j.labels,
                  datasets: [{
                    label: '銷售',
                    data: j.data,
                    borderWidth: 2,
                    tension: 0.3,
                    pointRadius: 3,
                  }]
                },
                options: {
                  responsive: true,
                  plugins: { legend: { display: false } },
                  scales: { y: { beginAtZero: true } }
                }
              });

            } catch (e) {
              console.error('fetchSales err', e);
            }
          }

          fetchSummary();
          fetchSales();
          setInterval(()=>{ fetchSummary(); fetchSales(); }, 60000);

          document.getElementById('salesType')?.addEventListener('change', ()=> {
          });
        })();
    </script>
}
