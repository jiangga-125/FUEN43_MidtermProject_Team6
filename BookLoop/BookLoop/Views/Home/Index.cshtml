@* /Views/Home/Index.cshtml *@
@{
    ViewBag.Title = "BookLoop 簿錄書城管理頁面";
}

<div class="row g-3 hero-cards">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card p-3">
            <div class="muted">今日訂單數</div>
            <div class="d-flex align-items-end justify-content-between">
                <div class="kpi">@ViewBag.TodayOrders</div>
                <span class="chip">+12% WoW</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card p-3">
            <div class="muted">今日營收</div>
            <div class="d-flex align-items-end justify-content-between">
                <div class="kpi">NT$ @(ViewBag.TodayRevenue)</div>
                <span class="chip">+7% WoW</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card p-3">
            <div class="muted">未出貨</div>
            <div class="d-flex align-items-end justify-content-between">
                <div class="kpi">@ViewBag.Unshipped</div>
                <span class="chip">SLA 2.1 天</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card p-3">
            <div class="muted">庫存告警</div>
            <div class="d-flex align-items-end justify-content-between">
                <div class="kpi">@ViewBag.LowStocks</div>
                <span class="chip">補貨中</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12 col-xl-7">
        <div class="card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="mb-0">近 14 天銷售走勢</h5>
                <div>
                    <select class="form-select form-select-sm">
                        <option>營收</option>
                        <option>訂單數</option>
                    </select>
                </div>
            </div>
            <canvas id="salesChart" height="120" class="mt-3"></canvas>
        </div>
    </div>
    <div class="col-12 col-xl-5">
        <div class="card p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="mb-0">最新訂單</h5>
                <a asp-area="Orders" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-secondary">查看全部</a>
            </div>
            <div class="table-responsive mt-2">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>訂單編號</th>
                            <th>會員</th>
                            <th>金額</th>
                            <th>狀態</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* 迴圈呈現你的訂單清單 *@
                        <tr>
                            <td><a href="#" class="text-decoration-none">ORD250905101303168</a></td>
                            <td>lee***@@gmail.com</td>
                            <td>NT$ 19,881</td>
                            <td class="status ship">已出貨</td>
                        </tr>
                        <tr>
                            <td><a href="#" class="text-decoration-none">ORD250905093012441</a></td>
                            <td>ann***@@yahoo.com</td>
                            <td>NT$ 2,180</td>
                            <td class="status pack">理貨中</td>
                        </tr>
                        <tr>
                            <td><a href="#" class="text-decoration-none">ORD250904221144903</a></td>
                            <td>wei***@@hotmail.com</td>
                            <td>NT$ 820</td>
                            <td class="status pay">待付款</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="text-muted small">提示：點擊訂單可進入訂單詳情頁。</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById("salesChart");
        if(ctx){
            new Chart(ctx, {
                type: "line",
                data: {
                    labels: Array.from({ length: 14 }, (_, i) => `D${i + 1}`),
                    datasets: [{ label:"營收", data:[12,9,11,14,10,16,13,18,21,20,22,19,24,28].map(x=>x*1000), tension:.35, fill:false }]
                },
                options: { responsive:true, plugins:{ legend:{ display:false } },
                    scales:{ y:{ ticks:{ callback:v=>"NT$ "+v.toLocaleString() }}}}
            });
        }
    </script>
}
